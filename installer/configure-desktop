#!/usr/bin/env bash
# Per-machine desktop configuration, run in the target after Calamares has
# created the user.
#
# The packages are already there — they were copied with the filesystem — so
# install.sh has nothing to download and takes the "already provisioned" path,
# which is the one that does the work that cannot be baked into an image:
# detect the monitors and write monitors.lua at the right scale, write gpu.lua
# for whatever card this machine has, deploy the config into the new user's
# home, apply the theme and the wallpaper, and hand it all to them.
#
# Runs inside the target with Calamares' chroot.
set -uo pipefail

REPO=/usr/local/share/hyprland-setup

[[ -d $REPO ]] || { echo "  $REPO is missing; nothing to configure"; exit 0; }

# Calamares has just created exactly one ordinary account. Ask the passwd
# database rather than trying to have the username handed down through
# Calamares' configuration, which does not pass one to shellprocess.
#
# Not "UID 1000": the live user holds a UID of its own on the medium, so the
# account Calamares creates is not guaranteed to get 1000 — the first install
# tested this way produced tester at 1001. Take the first ordinary account
# instead, and skip the live user in case this ever runs before it is removed.
USER_NAME="$(awk -F: '$3 >= 1000 && $3 < 65534 && $1 != "live" { print $1; exit }' /etc/passwd)"
if [[ -z $USER_NAME ]]; then
    echo "  no user with UID 1000; skipping desktop configuration"
    exit 0
fi

echo "  configuring the desktop for $USER_NAME"
bash "$REPO/install.sh" --for-user "$USER_NAME"
rc=$?

# The installer's own packages, now that nothing else needs them. This happens
# here rather than in strip-live for two reasons: strip-live runs before the
# desktop is configured, and the removal has to come after.
#
# -Rn, not -Rns. The cascade took 31 packages the first time it ran — it
# followed dependencies out of the installer and into things the desktop
# actually uses, and the install then stopped saying one package was missing.
# Remove exactly what was named, then let pacman identify true orphans: -Qtd
# lists only packages installed as dependencies that nothing now requires, so
# it cannot reach anything the desktop asked for by name.
if [[ $rc -eq 0 ]]; then
    echo "  removing the installer"
    pacman -Rn --noconfirm calamares cage qt6-wayland archinstall dialog \
        >/dev/null 2>&1 || true
    orphans="$(pacman -Qtdq 2>/dev/null)"
    if [[ -n $orphans ]]; then
        # shellcheck disable=SC2086
        pacman -Rns --noconfirm $orphans >/dev/null 2>&1 || true
    fi
fi

# Last one out. strip-live cannot remove these, because this script is one of
# them and runs after it. Unlinking a running script is safe: the shell holds
# the file open and the inode outlives the directory entry.
rm -rf /usr/local/lib/starch

exit $rc
