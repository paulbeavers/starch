#!/usr/bin/env bash
# Run Calamares in a window: centred, about half the screen, over the same
# picture the boot splash just showed.
#
# It used to run under cage, which by its own description "runs a single,
# maximized application". That is not a missing option — view_position() in
# cage's source maximizes any toplevel with no parent, which is every main
# window — so branding.desc's windowSize could never take effect and on a 5K
# display the installer was 5120 pixels wide.
#
# Hyprland is already on the medium and honours geometry. What it will not do
# is run as root:
#
#     Hyprland was launched with superuser privileges, but the privileges
#     check is not omitted.
#
# It is right. Calamares needs root because it partitions disks; a compositor
# does not. So the compositor runs as the live user and Calamares is elevated
# inside it, which is the arrangement that should have been used from the
# start. The live user has passwordless sudo on the medium.
#
# This is not the starch desktop. The config below is generated, twenty lines,
# and loads none of it: no bar, no autostart, no portals, no uwsm, no session
# targets. Nothing here waits on the network — which is what put a ninety
# second countdown on the screen the last time a compositor was involved.
set -uo pipefail

CONF=/tmp/starch-installer.lua
BG=/tmp/starch-installer-bg.png
LOG=/tmp/calamares-session.log
WATERMARK=/usr/share/plymouth/themes/starch/watermark.png

[[ $EUID -ne 0 ]] || {
    echo "installer-session must run as the live user, not root" >&2
    exit 1
}

# Hyprland refuses to start without this, and a login shell on a tty does not
# always have it.
if [[ -z ${XDG_RUNTIME_DIR:-} ]]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
    export XDG_RUNTIME_DIR
fi

scale="$(/usr/local/lib/starch/live-scale 2>/dev/null || echo 1)"

# The largest connected mode, which is the one Hyprland will light up. The
# first line of a connector's modes is its preferred mode.
width=0 height=0
for modes in /sys/class/drm/card*-*/modes; do
    [[ -r $modes ]] || continue
    conn="${modes%/modes}"
    [[ -r $conn/status && "$(cat "$conn/status")" == connected ]] || continue
    res="$(head -1 "$modes")"
    w="${res%%x*}"; h="${res##*x}"
    [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || continue
    if (( w * h > width * height )); then width=$w; height=$h; fi
done
(( width > 0 && height > 0 )) || { width=1920; height=1080; }

# Half the screen, floored at what Calamares needs to lay itself out — half of
# 1280x800 is smaller than that — and capped so it never touches the edges. Qt
# is scaling the contents, so the floor scales with it. awk because the scale
# factor is fractional.
read -r win_w win_h < <(awk -v w="$width" -v h="$height" -v s="$scale" 'BEGIN {
    if (s <= 0) s = 1
    ww = w / 2;  hh = h / 2
    minw = 900 * s;  minh = 620 * s
    if (ww < minw) ww = minw
    if (hh < minh) hh = minh
    if (ww > w * 0.92) ww = w * 0.92
    if (hh > h * 0.92) hh = h * 0.92
    printf "%d %d\n", ww, hh
}')

# The backdrop: the splash's own logo, on the splash's own colour, at the
# size and height Plymouth put it. plymouth-quit leaves its last frame in the
# framebuffer (--retain-splash), so what the compositor paints next is the
# same picture and the handover is not visible.
logo_h=$(( height * 40 / 100 ))
if [[ -r $WATERMARK ]] && command -v magick >/dev/null; then
    magick -size "${width}x${height}" "xc:#11111b" \
        \( "$WATERMARK" -resize "x${logo_h}" \) \
        -gravity center -geometry "+0-$(( height / 10 ))" -composite \
        "PNG24:$BG" 2>/dev/null || rm -f "$BG"
fi

cat > "$CONF" <<LUA
-- Generated by installer-session. The installer's compositor and nothing
-- else: this is not the starch desktop and loads none of it.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

hl.config({
    general    = { border_size = 0, gaps_in = 0, gaps_out = 0 },
    decoration = { rounding = 12, blur = { enabled = false }, shadow = { enabled = false } },
    animations = { enabled = false },
    input      = { follow_mouse = 1 },
    misc       = {
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
        -- Shows through until the wallpaper is up, and is the splash's colour
        -- so that moment looks like nothing happened.
        background_color         = "rgb(11111b)",
    },
})

-- ${width}x${height} detected, so the window is ${win_w}x${win_h}.
hl.window_rule({
    name  = "calamares",
    match = { class = "^([Cc]alamares)\$" },
    float = true, center = true, size = { $win_w, $win_h },
})

hl.on("hyprland.start", function()
    -- hyprpaper does not reliably apply its own config, so it is told over
    -- IPC instead — the same thing the desktop's wallpaper script does.
    hl.exec_cmd("sh -c 'hyprpaper & sleep 1; hyprctl hyprpaper wallpaper \",$BG\"'")

    -- Calamares partitions disks, so it is the only thing here that is root.
    -- The variables are named rather than passed with sudo -E: -E needs the
    -- sudoers policy to allow it, and naming them cannot silently lose one.
    hl.exec_cmd("sh -c 'sudo env XDG_RUNTIME_DIR=\"\$XDG_RUNTIME_DIR\" WAYLAND_DISPLAY=\"\$WAYLAND_DISPLAY\" QT_SCALE_FACTOR=$scale calamares -D6 2>>$LOG; hyprctl dispatch \"hl.dsp.exit()\"'")
end)
LUA

exec Hyprland -c "$CONF"
