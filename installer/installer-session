#!/usr/bin/env bash
# Run Calamares in a window: centred, about half the screen, on a plain
# background.
#
# It used to run under cage, which by its own description "runs a single,
# maximized application" — there is no windowed mode. That is why the
# windowSize and windowPlacement already in branding.desc never did anything:
# they cannot. On a 5K monitor the installer filled all 5120 pixels.
#
# Hyprland is already on the medium, so the installer gets a compositor that
# honours geometry. The config written below does nothing else: no bar, no
# autostart, no portals, no animations. It is not the desktop — starting the
# whole desktop to run the installer is what made an earlier build slow to
# come up and is not what this is.
#
# The size is measured rather than assumed, because "half" is wrong at both
# ends: half of 1280x800 is smaller than Calamares can lay itself out in, and
# on a hidpi panel Qt is scaling the contents up, so the floor has to scale
# with it.
set -uo pipefail

CONF=/tmp/starch-installer.lua
LOG=/tmp/calamares-session.log

scale="$(/usr/local/lib/starch/live-scale 2>/dev/null || echo 1)"
export QT_SCALE_FACTOR="$scale"

# The largest connected mode, which is the one Hyprland will light up. First
# line of a connector's modes is its preferred mode.
width=0 height=0
for modes in /sys/class/drm/card*-*/modes; do
    [[ -r $modes ]] || continue
    conn="${modes%/modes}"
    [[ -r $conn/status && "$(cat "$conn/status")" == connected ]] || continue
    res="$(head -1 "$modes")"
    w="${res%%x*}"; h="${res##*x}"
    [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || continue
    if (( w * h > width * height )); then width=$w; height=$h; fi
done
(( width > 0 && height > 0 )) || { width=1920; height=1080; }

# Half, floored at what Calamares needs and capped so it never touches the
# edges. Done in awk because the scale factor is fractional.
read -r win_w win_h < <(awk -v w="$width" -v h="$height" -v s="$scale" 'BEGIN {
    if (s <= 0) s = 1
    ww = w / 2;  hh = h / 2
    minw = 900 * s;  minh = 620 * s          # Calamares stops laying out below this
    if (ww < minw) ww = minw
    if (hh < minh) hh = minh
    if (ww > w * 0.92) ww = w * 0.92
    if (hh > h * 0.92) hh = h * 0.92
    printf "%d %d\n", ww, hh
}')

cat > "$CONF" <<LUA
-- Generated by installer-session. The installer's compositor, and nothing
-- else: this is not the starch desktop and does not load any of it.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

hl.config({
    general    = { border_size = 0, gaps_in = 0, gaps_out = 0 },
    decoration = { rounding = 12, blur = { enabled = false }, shadow = { enabled = false } },
    animations = { enabled = false },
    input      = { follow_mouse = 1 },
    misc       = {
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
        background_color         = "rgb(11111b)",
    },
})

-- $width x $height detected, so the window is ${win_w}x${win_h}.
hl.window_rule({
    name  = "calamares",
    match = { class = "^([Cc]alamares)$" },
    float = true, center = true, size = { $win_w, $win_h },
})

hl.on("hyprland.start", function()
    -- When Calamares exits, so does the compositor; the caller then falls
    -- through to the text installer, exactly as it did under cage.
    hl.exec_cmd("sh -c 'calamares -D6 2>>$LOG; hyprctl dispatch \"hl.dsp.exit()\"'")
end)
LUA

exec Hyprland -c "$CONF"
