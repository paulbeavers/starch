/* starch — Calamares branding stylesheet.
 *
 * Calamares loads stylesheet.qss from the branding component directory
 * (Branding::stylesheet) and applies it over the style: block in
 * branding.desc. Object names are Calamares' own — logoApp, sidebarApp,
 * sidebarMenuApp, mainApp; a selector that does not match changes nothing and
 * says nothing, so check before inventing one:
 *
 *     strings /usr/bin/calamares | grep -E '^(sidebar|logo|main)[A-Za-z]*$'
 *
 * Two rules learned the hard way, from a first attempt that put margins on
 * #logoApp and made this worse than the flush logo it was fixing:
 *
 *   - Use padding on the container, never margin on the logo. A margin is
 *     outside the widget, so the parent shows through it, and the parent is
 *     not painted by the branding style — it came out as white bars.
 *   - A widget given padding here paints only what QSS tells it to, so the
 *     background colour has to be stated or the padding is bare. It
 *     duplicates SidebarBackground from branding.desc, which is a real cost;
 *     the two have to be changed together.
 */

#sidebarApp {
    background-color: #181825;
    padding-top: 18px;
    padding-bottom: 14px;
}
