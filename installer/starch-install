#!/usr/bin/env bash
# starch installer: start the front end, then do what it asked.
#
#     starch-install            from a shell on the medium, as root
#     starch-install --resume   back from a kmscon restart, at the disk step
#
# The front end is starch_installer, a Textual app; it asks the questions and
# runs starch-backend, which installs. This script only prepares the console
# and acts on how the front end exits: reboot, power off, or a shell.
#
# On kmscon (the medium's normal console) the font, size and palette are
# kmscon's. On the plain Linux console — kmscon's fallback when it cannot
# start — they are set here, because its own are an 8x16 bitmap font in CGA
# colours: unreadable on a retina panel, and its blue is near-invisible.
set -uo pipefail

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

export PYTHONPATH=/usr/local/lib/starch${PYTHONPATH:+:$PYTHONPATH}

panel_width() {
    local f w
    for f in /sys/class/drm/card*-*/status; do
        [[ $(cat "$f" 2>/dev/null) == connected ]] || continue
        w=$(head -1 "${f%/status}/modes" 2>/dev/null | cut -dx -f1)
        [[ $w =~ ^[0-9]+$ ]] && { echo "$w"; return; }
    done
    w=$(cut -d, -f1 /sys/class/graphics/fb0/virtual_size 2>/dev/null)
    [[ $w =~ ^[0-9]+$ ]] && echo "$w"
}

if [[ $TERM == linux ]]; then
    # Terminus at 32px still gave 180 columns of small text on a 2880-wide
    # panel; setfont -d doubles 24px to 48px, about 120x37 there.
    w=$(panel_width)
    if [[ -n $w && $w -ge 2560 ]]; then setfont -d ter-v24b 2>/dev/null
    elif [[ -n $w && $w -ge 1920 ]]; then setfont ter-v32b 2>/dev/null
    fi
    # Catppuccin Mocha over the CGA palette, entry by entry (ESC ] P n rrggbb),
    # with starch's lavender in the magenta slots rather than pink.
    for e in 01e1e2e 1f38ba8 2a6e3a1 3f9e2af 489b4fa 5b4befe 694e2d5 7cdd6f4 \
             8585b70 9f38ba8 Aa6e3a1 Bf9e2af C89b4fa Db4befe E94e2d5 Fcdd6f4; do
        printf '\e]P%s' "$e"
    done
    clear
fi

python3 -m starch_installer "$@"
rc=$?

case $rc in
    10) systemctl reboot ;;
    11) systemctl poweroff ;;
    # kmscon is restarting with a new keyboard layout. The marker tells the
    # next session to resume, whether this ran from starch-session or by hand
    # from its shell.
    12) mkdir -p /run/starch; : >/run/starch/restarting; exit 12 ;;
esac
exit 0
