#!/usr/bin/env bash
# starch installer. tty1 runs this at boot.
#
# starch is install media only. Once it finishes there is no starch left on
# the machine: no custom repository, no branding, no hooks. What remains is
# plain Arch with Hyprland on top, updated with pacman like any other Arch.
#
# Two stages, deliberately separated:
#
#   1. archinstall does the base install — partitioning, filesystems, LUKS,
#      bootloader, user accounts. That is the part where a bug destroys data,
#      so it stays with the upstream tool that is maintained and tested.
#   2. This script then applies the desktop on top, by running the repo's own
#      install.sh inside the new system.
#
# The two are not wired together through archinstall's JSON, because its schema
# moves between releases and a silent mismatch would look like a working
# install right up until first boot.
set -uo pipefail

REPO_SRC=/usr/local/share/hyprland-setup
TARGET=/mnt

# tty1 autologins as the unprivileged live user, but everything this script
# does needs root: archinstall refuses to run without it, and so do mount,
# arch-chroot, reboot and poweroff. Re-exec once through sudo rather than
# prefixing each call, so there is one place where privilege is acquired.
#
# The live user has passwordless sudo (see /etc/sudoers.d/00-live), so this
# does not prompt. Deliberately not `sudo -E`: preserving the environment
# needs a SETENV tag in sudoers, which that rule does not grant, so -E would
# fail outright. Nothing here needs the caller's environment — the menu's
# shell sets STARCH_SHELL itself, after this re-exec has already happened.
if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

C_B=$'\e[1;34m'; C_G=$'\e[1;32m'; C_Y=$'\e[1;33m'; C_R=$'\e[1;31m'; C_D=$'\e[2m'; C_0=$'\e[0m'
say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s\n' "$C_B" "$C_0" "$*"; }
ok()   { printf '    %s✓%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '    %s!%s %s\n' "$C_Y" "$C_0" "$*"; }
err()  { printf '\n%sERROR:%s %s\n' "$C_R" "$C_0" "$*" >&2; }

banner() {
    clear
    cat <<'EOF'

      _             _
  ___| |_ __ _ _ __| |__
 / __| __/ _` | '__| '_ \
 \__ \ || (_| | |  | | | |
 |___/\__\__,_|_|  |_| |_|

 start arch -- Arch Linux + Hyprland

EOF
}

# ── pre-flight ────────────────────────────────────────────────────────────────
preflight() {
    step "Checking the environment"

    if [[ -d /sys/firmware/efi ]]; then ok "UEFI boot"
    else warn "BIOS/legacy boot — pick a matching bootloader in archinstall"; fi

    if ping -c1 -W3 archlinux.org >/dev/null 2>&1; then
        ok "network is up"
    else
        warn "no network. The install downloads packages and will fail without it."
        say  "    Wi-Fi: run 'iwctl' on another VT (Alt+F2), then come back."
        return 1
    fi

    local mem
    mem=$(awk '/MemTotal/{printf "%d", $2/1024/1024}' /proc/meminfo)
    [[ ${mem:-0} -ge 2 ]] && ok "${mem}GB RAM" || warn "only ${mem}GB RAM; this may be tight"
    return 0
}

# ── find the system archinstall just created ──────────────────────────────────
# archinstall unmounts the target when it finishes, so the root filesystem has
# to be found again. A partition that has both /var/lib/pacman and /etc/fstab
# is an installed Arch system; anything else is someone else's disk.
# A partition holding both /var/lib/pacman and /etc/fstab is an installed Arch
# system. Two wrinkles, both of which archinstall produces by default for the
# options people actually pick:
#
#   btrfs  root lives on the @ subvolume, so a plain mount of the partition
#          shows @/var/lib/pacman rather than /var/lib/pacman.
#   LUKS   the partition will not mount at all until it is unlocked, so an
#          encrypted install is invisible here. Say so rather than reporting
#          "nothing found", which sends people looking for the wrong problem.
#
# Emits "device<TAB>mount-options", the options being whatever the real
# read-write mount also needs (the subvolume, for btrfs).
find_target_root() {
    local dev fstype tmp=/run/starch-probe found=() locked=()
    mkdir -p "$tmp"

    while read -r dev fstype; do
        if [[ $fstype == crypto_LUKS ]]; then
            locked+=("$dev")
            continue
        fi

        if mount -o ro "$dev" "$tmp" 2>/dev/null; then
            if [[ -d $tmp/var/lib/pacman && -f $tmp/etc/fstab ]]; then
                found+=("$dev	")
            elif [[ -d $tmp/@/var/lib/pacman && -f $tmp/@/etc/fstab ]]; then
                found+=("$dev	subvol=@")
            fi
            umount "$tmp" 2>/dev/null
        fi
    done < <(lsblk -pnro NAME,TYPE,FSTYPE | awk '$2=="part"{print $1, $3}')

    rmdir "$tmp" 2>/dev/null

    if [[ ${#locked[@]} -gt 0 ]]; then
        printf 'LOCKED	%s\n' "${locked[@]}"
    fi
    # An empty array still emits one blank line through printf, which the
    # caller would read back as a single candidate named "".
    [[ ${#found[@]} -gt 0 ]] && printf '%s\n' "${found[@]}"
    return 0
}

# ── stage 2: put the desktop on the new system ────────────────────────────────
apply_desktop() {
    local root_dev="$1" mount_opts="${2:-}"

    step "Mounting $root_dev${mount_opts:+ ($mount_opts)}"
    mountpoint -q "$TARGET" && umount -R "$TARGET" 2>/dev/null
    mkdir -p "$TARGET"
    if [[ -n $mount_opts ]]; then
        mount -o "$mount_opts" "$root_dev" "$TARGET" || { err "could not mount $root_dev"; return 1; }
    else
        mount "$root_dev" "$TARGET" || { err "could not mount $root_dev"; return 1; }
    fi

    # Bring up the rest of the target's filesystems — the ESP especially, since
    # a bootloader or kernel update inside the chroot writes to it.
    #
    # Both -T and --target-prefix are required. Without -T, mount -a reads the
    # live ISO's own fstab. Without --target-prefix, every mount point in the
    # target's fstab is resolved against the running system, so "/boot" would
    # mount the target's ESP over the live environment's /boot.
    if [[ -f $TARGET/etc/fstab ]]; then
        mount -a -T "$TARGET/etc/fstab" --target-prefix "$TARGET" 2>/dev/null || true
    fi
    ok "mounted:"
    findmnt -nR "$TARGET" -o TARGET,SOURCE | sed 's/^/      /'

    # The first non-system account is the one archinstall created.
    local user home
    user=$(awk -F: '$3>=1000 && $3<65000 {print $1; exit}' "$TARGET/etc/passwd")
    if [[ -z $user ]]; then
        warn "no regular user found in the new system; installing for root only"
        user=root; home=/root
    else
        home=$(awk -F: -v u="$user" '$1==u{print $6}' "$TARGET/etc/passwd")
        ok "installing the desktop for '$user'"
    fi

    step "Copying the setup into the new system"
    # Into the user's home, not /opt. Nothing about the installed system should
    # look like it came from a distro — this ends up exactly where it would be
    # if they had cloned the repo themselves, and re-running it later is the
    # same command it would have been.
    rm -rf "$TARGET$home/hyprland-setup"
    cp -r "$REPO_SRC" "$TARGET$home/hyprland-setup"
    ok "at $home/hyprland-setup"

    step "Running install.sh inside the new system"
    say "    This installs the desktop packages and deploys the config."
    say "    ${C_D}--for-user is install.sh's mode for exactly this: it is root,"
    say "    so it skips sudo entirely, writes the config into $user's home,"
    say "    and chowns it back at the end. Without it install.sh refuses to"
    say "    run as root, which is right everywhere except inside a chroot.${C_0}"
    say

    # pacman inside the chroot needs working DNS.
    cp /etc/resolv.conf "$TARGET/etc/resolv.conf" 2>/dev/null || true

    if arch-chroot "$TARGET" "$home/hyprland-setup/install.sh" --for-user "$user"; then
        ok "desktop installed for $user"
    else
        err "install.sh failed inside the new system"
        say "    The base Arch install is intact. To retry:"
        say "      arch-chroot $TARGET $home/hyprland-setup/install.sh --for-user $user"
        return 1
    fi
    return 0
}

# ── the install flow ──────────────────────────────────────────────────────────
do_install() {
    banner
    preflight || { say; read -rp "Continue anyway? [y/N] " a; [[ ${a,,} == y ]] || return 1; }

    cat <<EOF

${C_B}This installs Arch Linux, then the Hyprland desktop on top.${C_0}

  Stage 1  archinstall — disks, filesystems, bootloader, your user account.
           ${C_D}Its own interface. Take your time; this is the part that
           writes to disk.${C_0}
  Stage 2  the desktop — packages and config from this repo.

EOF
    read -rp "Start? [y/N] " a; [[ ${a,,} == y ]] || return 1

    step "Stage 1: archinstall"
    say "    Handing over to archinstall..."
    sleep 2
    if ! archinstall; then
        err "archinstall did not complete"
        return 1
    fi

    step "Stage 2: the desktop"
    local -a roots=() locked=()
    while IFS= read -r line; do
        [[ $line == LOCKED* ]] && locked+=("${line#LOCKED	}") || roots+=("$line")
    done < <(find_target_root)

    if [[ ${#locked[@]} -gt 0 ]]; then
        warn "encrypted partitions found, which cannot be inspected while locked:"
        printf '      %s\n' "${locked[@]}"
        say  "      Unlock with: cryptsetup open <device> root"
        say  "      then re-run:  starch-install --desktop-only"
    fi

    local target="" opts=""
    case ${#roots[@]} in
        0) err "no installed Arch system found on any disk"
           say "    If archinstall did finish, unlock any encrypted volume and run:"
           say "      starch-install --desktop-only"
           return 1 ;;
        1) target="${roots[0]%%	*}"; opts="${roots[0]#*	}"
           ok "found the new system on $target" ;;
        *) say "    More than one Arch install found:"
           local i=1; for r in "${roots[@]}"; do say "      $i) ${r%%	*}"; ((i++)); done
           read -rp "    Which one did you just install? [1-${#roots[@]}] " n
           local pick="${roots[$((n-1))]:-}"
           [[ -n $pick ]] || { err "no selection"; return 1; }
           target="${pick%%	*}"; opts="${pick#*	}" ;;
    esac

    apply_desktop "$target" "$opts" || return 1

    step "Done"
    say "    Remove the install media and reboot."
    say
    read -rp "Reboot now? [y/N] " a
    [[ ${a,,} == y ]] && { umount -R "$TARGET" 2>/dev/null; reboot; }
    return 0
}

# ── menu ──────────────────────────────────────────────────────────────────────
[[ ${1:-} == --desktop-only ]] && {
    say "Scanning for installed Arch systems..."
    found_any=0
    while IFS= read -r line; do
        found_any=1
        if [[ $line == LOCKED* ]]; then
            say "  ${line#LOCKED	}  (encrypted — unlock it first)"
        else
            dev="${line%%	*}"; mo="${line#*	}"
            say "  ${dev}${mo:+  [$mo]}"
        fi
    done < <(find_target_root)
    [[ $found_any -eq 1 ]] || say "  none"
    read -rp "Root partition to set up (e.g. /dev/sda2): " d
    [[ -b $d ]] || { err "$d is not a block device"; exit 1; }
    read -rp "Mount options, blank for none (btrfs root is usually subvol=@): " o
    apply_desktop "$d" "$o"; exit $?
}

while true; do
    banner
    cat <<EOF
  ${C_B}1${C_0}  Install Arch + Hyprland
  ${C_B}2${C_0}  Shell            ${C_D}(the installer is also on other VTs: Alt+F2)${C_0}
  ${C_B}3${C_0}  Reboot
  ${C_B}4${C_0}  Power off

EOF
    read -rp "  Choice [1-4]: " choice
    case "$choice" in
        1) do_install; say; read -rp "Press Enter to return to the menu... " _ ;;
        2) say; say "Type 'exit' to come back to the menu."
           # STARCH_SHELL stops ~/.bash_profile exec'ing the installer again,
           # which would drop straight back to this menu.
           STARCH_SHELL=1 bash -l ;;
        3) reboot ;;
        4) poweroff ;;
        *) ;;
    esac
done
