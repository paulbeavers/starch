#!/usr/bin/env bash
# Put a kernel in the target's /boot.
#
# mkarchiso empties /boot in the squashfs before packaging it ("Delete all
# files in /boot"), because the live medium boots its kernel from the ISO
# filesystem rather than from the image. Copying that image onto a disk
# therefore produces a system that pacman believes has the linux package
# installed and that has no kernel on disk. Without this, mkinitcpio fails with
#
#     ERROR: Invalid option -k -- '/boot/vmlinuz-linux' must be readable
#
# and even if it did not, there would be nothing for the bootloader to boot.
#
# The kernel is taken from /usr/lib/modules/<version>/vmlinuz, not from the
# install medium. The linux package installs it in both places and mkarchiso
# only empties /boot, so that copy is inside the squashfs and arrives on the
# target with everything else. Reading it from the medium was the first
# approach and it broke on real hardware: the medium is not always still
# mounted by the time this runs, and where it is mounted is not something to
# rely on. Nothing here needs the medium at all now.
#
#     copy-kernel --check <root>   say whether a kernel can be found
#     copy-kernel <root>           put it in place
#
# With --check before the disk is touched, <root> is the live system, which
# carries the same file the target will get.
set -uo pipefail

MODE=copy
if [[ ${1:-} == --check ]]; then MODE=check; shift; fi
ROOT="${1:-/}"

shopt -s nullglob
kernels=("$ROOT"/usr/lib/modules/*/vmlinuz)
shopt -u nullglob

if [[ ${#kernels[@]} -eq 0 ]]; then
    echo "  no kernel under $ROOT/usr/lib/modules/*/vmlinuz"
    echo "  the linux package installs one there; without it there is nothing to boot"
    exit 1
fi

# More than one kernel is possible (linux and linux-lts, say). Prefer the one
# matching what the medium is running, and otherwise take the newest.
KERNEL=""
for k in "${kernels[@]}"; do
    [[ $k == */$(uname -r)/vmlinuz ]] && KERNEL="$k"
done
[[ -n $KERNEL ]] || KERNEL="$(printf '%s\n' "${kernels[@]}" | sort -V | tail -1)"

if [[ $MODE == check ]]; then
    echo "  kernel available: ${KERNEL#"$ROOT"}"
    exit 0
fi

[[ -d $ROOT ]] || { echo "  target $ROOT does not exist"; exit 1; }
install -d "$ROOT/boot"
cp -f "$KERNEL" "$ROOT/boot/vmlinuz-linux" || exit 1
echo "  installed /boot/vmlinuz-linux from ${KERNEL#"$ROOT"}"
