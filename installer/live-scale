#!/usr/bin/env bash
# Print the scale factor the installer should use on this display.
#
# This answers "how dense is this panel", nothing more. Two things consume it
# and they must not both act: live-prepare gives it to Hyprland as the monitor
# scale when it divides the resolution into whole pixels, and only when it does
# not does start-installer fall back to scaling Qt with it instead.
#
# It used to be read as "the QT_SCALE_FACTOR", which was right when the medium
# ran the installer full screen under cage and nothing else scaled. Hyprland
# does, so taking this as a Qt factor as well drew the installer at scale
# squared.
#
# An installed system does not use this: install.sh measures the display it is
# installing onto and writes monitors.lua.
#
# The decision is on density, not resolution. A 5120-wide desktop monitor and a
# 2880-wide laptop panel are both "big numbers" and want opposite things: the
# first is about 160dpi and looks absurd doubled, the second is about 220dpi and
# is unreadable left alone. EDID carries the physical size, so ask.
set -uo pipefail

width=0 dpi=0
for modes in /sys/class/drm/card*-*/modes; do
    [[ -r $modes ]] || continue
    conn="${modes%/modes}"
    [[ -r $conn/status && "$(cat "$conn/status")" == connected ]] || continue

    res="$(head -1 "$modes")"
    w="${res%%x*}"
    [[ $w =~ ^[0-9]+$ ]] || continue
    (( w > width )) && width=$w

    # EDID byte 21 is the horizontal image size in centimetres. Zero means the
    # display did not say, which projectors and some virtual outputs do.
    cm=0
    if [[ -r $conn/edid ]]; then
        cm=$(od -An -tu1 -j21 -N1 "$conn/edid" 2>/dev/null | tr -d ' ')
        [[ $cm =~ ^[0-9]+$ ]] || cm=0
    fi
    if (( cm > 0 )); then
        # inches = cm / 2.54, so dpi = px * 254 / (cm * 100).
        d=$(( w * 254 / (cm * 100) ))
        (( d > dpi )) && dpi=$d
    fi
done

# Density, not resolution: a 5120-wide desktop monitor and a 2880-wide laptop
# panel are both large numbers, and the first is about 160dpi and looks absurd
# doubled while the second is about 220dpi and is unreadable left alone.
if   (( dpi >= 180 ));   then echo 2
elif (( dpi >= 130 ));   then echo 1.5
elif (( dpi > 0 ));      then echo 1
elif (( width >= 2560 )); then echo 2      # no EDID; fall back to resolution
else                          echo 1
fi
