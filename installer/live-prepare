#!/usr/bin/env bash
# Work out what this machine needs, before the compositor starts.
#
# Two things have to be decided from the hardware in front of us rather than
# baked into the image: how big the installer window should be, and whether the
# display needs scaling. Both are written as Lua that hyprland.lua picks up.
#
# Runs as the live user on tty1, from .bash_profile, immediately before
# Hyprland is exec'd.
set -uo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR="$CFG/hypr"

# The largest connected mode; the first line of a connector's modes is its
# preferred one.
width=0 height=0
for modes in /sys/class/drm/card*-*/modes; do
    [[ -r $modes ]] || continue
    conn="${modes%/modes}"
    [[ -r $conn/status && "$(cat "$conn/status")" == connected ]] || continue
    res="$(head -1 "$modes")"
    w="${res%%x*}"; h="${res##*x}"
    [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || continue
    if (( w * h > width * height )); then width=$w; height=$h; fi
done
(( width > 0 && height > 0 )) || { width=1920; height=1080; }

# ── display scale ─────────────────────────────────────────────────────────────
# live-scale decides on density, not resolution. Hyprland will not take any
# number though: RESOLUTION / SCALE has to land on a whole pixel in both axes,
# and it snaps silently to the nearest legal value rather than complaining. So
# check before writing, and write nothing if the answer is 1 — Hyprland's own
# detection is right when there is nothing to say.
scale="$(/usr/local/lib/starch/live-scale 2>/dev/null || echo 1)"
legal=$(awk -v w="$width" -v h="$height" -v s="$scale" 'BEGIN {
    if (s <= 1) { print 0; exit }
    x = w / s; y = h / s
    print (x == int(x) && y == int(y)) ? 1 : 0
}')
if [[ $legal == 1 ]]; then
    comp_scale="$scale"
    cat > "$HYPR/monitors.lua" <<LUA
-- Written by live-prepare at boot, from this machine's panel. Install media
-- only: an installed system gets its own from install.sh.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = $scale })
LUA
else
    comp_scale=1
    rm -f "$HYPR/monitors.lua"
fi

# What the compositor is actually scaling by — $scale only if it was legal and
# written above, 1 otherwise. start-installer needs this to decide whether Qt
# should scale as well, and it must not when Hyprland already is.
printf '%s\n' "$comp_scale" > "$HYPR/.live-compositor-scale"

# ── the installer window ──────────────────────────────────────────────────────
# Half the screen, floored at what Calamares needs to lay itself out in — half
# of 1280x800 is smaller than that — and capped so it never touches the edges.
# Qt scales the contents, so the floor scales with it.
# hl.window_rule sizes are LOGICAL pixels: the compositor divides the panel by
# its scale and lays windows out in what is left. So all of this has to happen
# in logical space.
#
# It did not. It sized from the raw panel and multiplied the floor by the scale
# on top, which on a 2880x1800 retina panel at scale 2 asked for an 1800x1240
# window on a 1440x900 logical screen — wider and taller than the display, so
# centring put its origin at -180,-170 and the top of the installer, where the
# fields are, was off the screen entirely.
read -r win_w win_h < <(awk -v w="$width" -v h="$height" -v s="$comp_scale" 'BEGIN {
    if (s <= 0) s = 1
    lw = w / s;   lh = h / s          # what the compositor actually lays out on
    ww = lw / 2;  hh = lh / 2
    # The room Calamares needs to lay itself out, in logical pixels. Not
    # multiplied by the scale: a logical pixel is already bigger on a scaled
    # output, and multiplying here counts the same density a second time.
    if (ww < 900) ww = 900
    if (hh < 620) hh = 620
    # Last, so it wins: never bigger than the screen it has to be centred on.
    if (ww > lw * 0.92) ww = lw * 0.92
    if (hh > lh * 0.92) hh = lh * 0.92
    printf "%d %d\n", ww, hh
}')

# Calamares' Wayland app_id is reverse-DNS — io.calamares.calamares — and a
# rule matching only "calamares" silently does not apply, which is how the
# installer came up tiled across the whole screen with the rule sitting right
# there looking correct. Both spellings are matched: the plain one is what an
# X11 build reports through XWayland. [.] rather than \. because this is a
# Lua string first and a regex second, and Lua 5.4 rejects \. as an invalid
# escape sequence — the whole config would fail to load, not just the rule.
cat > "$HYPR/live-window.lua" <<LUA
-- Written by live-prepare at boot. ${width}x${height} panel, compositor
-- scale $comp_scale, so ${win_w}x${win_h} logical.
hl.window_rule({
    name  = "calamares",
    match = { class = "^(io[.]calamares[.]calamares|[Cc]alamares)\$" },
    float = true, center = true, size = { $win_w, $win_h },
})
LUA

# ── the wallpaper, if this panel wants the other render ──────────────────────
# The image bakes the 16:9 render, because at build time there is no panel to
# ask. Here there is. Same 19/10 test install.sh uses: wider than a widescreen
# gets the ultrawide layout, which is laid out for the extra width rather than
# being the 16:9 one stretched across it.
#
# --no-reload because nothing is running yet; Hyprland starts moments from now
# and hyprpaper reads the file it just rewrote. Non-fatal: a medium with the
# wrong-aspect wallpaper is a cosmetic problem, a medium that will not boot is
# not.
if (( width * 10 > height * 19 )); then
    wide="$(ls "$HOME"/Pictures/wallpapers/*-5120x2160.png 2>/dev/null | head -1)"
    if [[ -n $wide && -x $HYPR/scripts/wallpaper.sh ]]; then
        "$HYPR/scripts/wallpaper.sh" --no-reload --set "$wide" >/dev/null 2>&1 || true
    fi
fi

exit 0
