#!/usr/bin/env bash
# Point systemd-boot at the kernel pacman keeps up to date.
#
# Calamares' systemd-boot support ignores the `kernel:` and `img:` settings in
# bootloader.conf. It runs `kernel-install add`, which copies the kernel and an
# initramfs to /boot/<machine-id>/<version>/ and writes an entry naming that
# copy. Nothing on Arch ever runs kernel-install again. A kernel upgrade
# refreshes /boot/vmlinuz-linux and /boot/initramfs-linux.img through
# mkinitcpio's pacman hooks, deletes /usr/lib/modules/<old version>, and leaves
# the entry booting the old kernel against a system with none of its modules.
# Root still mounts from the initramfs; /boot, which is vfat, does not, and
# the machine lands in emergency mode. Installs worked for weeks and then died
# on the first `pacman -Syu` that carried a kernel.
#
# So the entries are rewritten here to the stable names, the same layout the
# Arch wiki gives for systemd-boot, and the kernel-install copies are removed
# so there is only one kernel on the ESP to be wrong about.
#
# After Calamares' bootloader module, which writes /etc/kernel/cmdline and the
# entries this replaces, and before splash-cmdline, which edits whatever
# entries it finds.
#
# Runs inside the target with Calamares' chroot.
set -uo pipefail

ENTRIES=/boot/loader/entries
LOADER=/boot/loader/loader.conf

# The images mkinitcpio's preset builds. Without them the entries would point
# at nothing, which is worse than the kernel-install entry: that one at least
# boots until the first kernel upgrade.
for f in /boot/vmlinuz-linux /boot/initramfs-linux.img; do
    if [[ ! -f $f ]]; then
        echo "  WARNING: $f is missing; leaving Calamares' boot entries alone."
        echo "  This system will stop booting after its first kernel upgrade."
        exit 0
    fi
done

# The kernel arguments Calamares worked out: root=UUID=..., rootflags for a
# btrfs subvolume, resume and so on. kernel-install read them from here.
options="$(cat /etc/kernel/cmdline 2>/dev/null)"
if [[ -z $options ]]; then
    shopt -s nullglob
    for entry in "$ENTRIES"/*.conf; do
        options="$(sed -n 's/^options[[:space:]]\+//p' "$entry" | head -1)"
        [[ -n $options ]] && break
    done
fi
if [[ $options != *root=* ]]; then
    echo "  WARNING: no root= argument found; leaving Calamares' boot entries alone."
    exit 0
fi

install -d "$ENTRIES"
cat > "$ENTRIES/starch.conf" <<EOF
title   starch
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options $options
EOF
echo "  starch.conf"

if [[ -f /boot/initramfs-linux-fallback.img ]]; then
    cat > "$ENTRIES/starch-fallback.conf" <<EOF
title   starch (fallback initramfs)
linux   /vmlinuz-linux
initrd  /initramfs-linux-fallback.img
options $options
EOF
    echo "  starch-fallback.conf"
fi

# Calamares' loader.conf says `default <machine-id>*`, which would match
# nothing once its entries are gone; systemd-boot would then pick by sort
# order. Keep its other lines.
if [[ -f $LOADER ]] && grep -q '^default' "$LOADER"; then
    sed -i 's/^default.*/default starch.conf/' "$LOADER"
else
    echo "default starch.conf" >> "$LOADER"
fi

machine_id="$(cat /etc/machine-id 2>/dev/null)"
if [[ -n $machine_id ]]; then
    rm -f "$ENTRIES/$machine_id"-*.conf
    rm -rf "/boot/$machine_id"
    echo "  removed the kernel-install copy under /boot/$machine_id"
fi

exit 0
