#!/usr/bin/env bash
# Turn the copied live filesystem into an installed system.
#
# Calamares installs by copying the ISO's own filesystem, which means the
# target starts out as a clone of the install medium — autologin, a passwordless
# live user, the installer itself, and an initramfs built to boot from a
# squashfs on a CD. Every one of those has to go, and going quietly is not an
# option: a leftover passwordless sudo rule is a security bug, and leftover
# archiso hooks make the installed system unbootable.
#
# Runs inside the target with Calamares' chroot, so paths here are absolute in
# the new system.
set -uo pipefail

say() { printf '  %s\n' "$*"; }

LIVE_USER=live

say "removing the live user"
if id "$LIVE_USER" &>/dev/null; then
    # The account is autologin-only and has no password; nothing in it is worth
    # keeping and its home is a copy of the skeleton anyway.
    userdel -r "$LIVE_USER" 2>/dev/null || userdel "$LIVE_USER" 2>/dev/null || true
fi
rm -rf "/home/$LIVE_USER"
rm -f /etc/sysusers.d/zz-live.conf

say "removing passwordless sudo and autologin"
rm -f /etc/sudoers.d/00-live
rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true

say "removing the installer"
rm -f /usr/local/bin/starch-install /usr/local/bin/starch-setup
rm -rf /etc/calamares /usr/share/calamares
# Not /usr/local/lib/starch: configure-desktop lives there and has not run yet.
# It clears the directory itself once it is finished.

say "removing archiso boot machinery"
# The live image boots through archiso's mkinitcpio hooks, which look for a
# squashfs on removable media. Left in place, the installed system builds an
# initramfs that cannot find its own root.
rm -f /etc/mkinitcpio.conf.d/archiso.conf

# The preset is the part that actually drives mkinitcpio, and releng's builds
# one image called "archiso" from the config just deleted. Removing the config
# alone changes nothing: the preset still names it, and the installed system
# ends up with no default or fallback initramfs at all. Put the stock preset
# from the linux package back.
cat > /etc/mkinitcpio.d/linux.preset <<'PRESET'
# mkinitcpio preset file for the 'linux' package

ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default' 'fallback')

default_image="/boot/initramfs-linux.img"

fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
PRESET
rm -f /etc/systemd/system/etc-pacman.d-gnupg.mount
rm -f /etc/systemd/system/pacman-init.service
rm -f /etc/systemd/system/choose-mirror.service
rm -f /etc/systemd/system/livecd-*.service
rm -f /root/.automated_script.sh /root/.zlogin
rm -f /etc/motd

say "disabling services that were only enabled for the live image"
# A copied filesystem inherits what the ISO had switched on, and archiso
# switches on a lot that has no business being a default on someone's machine:
#
#   sshd            an installed desktop should not come up listening
#   iwd + networkd  NetworkManager owns networking here, and two of them
#                   fighting over an interface is a bad first boot
#   choose-mirror   picks a mirror from the kernel command line
#   pacman-init     populates the live keyring
#   livecd-talk     the accessibility screen reader for the install medium
#
# systemctl disable, not rm. Deleting the .wants symlink looks like it works
# and does not: systemd-networkd also installs an Alias, and after removing
# every .wants entry by hand the leftover
# /etc/systemd/system/dbus-org.freedesktop.network1.service still had it
# reporting "enabled". systemctl knows about Alias= and Also= and takes the
# whole set. --no-reload because there is no manager listening in a chroot.
for unit in sshd.service iwd.service systemd-networkd.service \
            systemd-networkd.socket systemd-networkd-wait-online.service \
            choose-mirror.service pacman-init.service \
            livecd-talk.service livecd-alsa-unmuter.service; do
    systemctl disable --no-reload "$unit" >/dev/null 2>&1 || true
done
rm -f /etc/systemd/network/*.network

# systemd-resolved stays enabled on purpose: /etc/resolv.conf is a symlink to
# its stub, so disabling it here would leave the installed system pointing at a
# file nothing writes, and DNS would simply stop.
#
# The hypervisor guest agents (hv_*, vboxservice, vmtoolsd) also stay. Each is
# ConditionVirtualization-gated, so on real hardware they do nothing, and in a
# VM they are what the user would have had to install by hand.

say "restoring a normal boot"
systemctl set-default graphical.target 2>/dev/null || true

say "done"
