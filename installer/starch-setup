#!/usr/bin/env bash
# starch guided install.
#
# Asks six questions, then installs Arch and the Hyprland desktop without
# further interaction.
#
# The disk work is done here rather than handed to archinstall's JSON. Its
# "default_layout" mode does not compute a layout from a device name — it
# requires every partition spelled out with sizes, byte offsets, sector sizes
# and UUIDs, which is a great deal of fiddly generated input for the one
# operation that destroys data if it is wrong. Its "pre_mounted_config" mode
# takes filesystems that are already mounted, so starch partitions with sgdisk
# and mkfs (visible, boring, testable) and archinstall does the rest: pacstrap,
# bootloader, users, locale, mirrors.
#
# It also means /mnt is still mounted when archinstall finishes, so stage 2
# needs no guessing about where the new system went.
set -uo pipefail

REPO_SRC=/usr/local/share/hyprland-setup
TARGET=/mnt
WORK=/run/starch

C_B=$'\e[1;34m'; C_G=$'\e[1;32m'; C_Y=$'\e[1;33m'; C_R=$'\e[1;31m'; C_D=$'\e[2m'; C_0=$'\e[0m'
say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s\n' "$C_B" "$C_0" "$*"; }
ok()   { printf '    %s✓%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '    %s!%s %s\n' "$C_Y" "$C_0" "$*"; }
err()  { printf '\n%sERROR:%s %s\n' "$C_R" "$C_0" "$*" >&2; }
die()  { err "$*"; exit 1; }

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

VERBOSE=0
for a in "$@"; do
    case "$a" in
        -v|--verbose) VERBOSE=1 ;;
        *) die "unknown option: $a (try --verbose)" ;;
    esac
done

# spin() hides the cursor. Put it back on any exit, including Ctrl-C, or the
# terminal is left without one.
trap 'printf "\e[?25h"' EXIT

# Run something slow with its output in a log instead of on the screen, showing
# one line that says it is still going. The output is kept, not discarded — it
# is what show_logs prints if the thing fails.
#
# stdin is /dev/null because nothing here is meant to ask questions. If one of
# these ever does, it gets EOF and fails, rather than waiting for an answer
# nobody can see it asking for.
#
# The frames are ASCII deliberately: this runs on the Linux console, where the
# font is whatever the kernel loaded, and the usual braille spinners come out
# as blanks or boxes.
spin() {
    local label="$1" log="$2"; shift 2

    if [[ $VERBOSE -eq 1 || ! -t 1 ]]; then
        say "    $label..."
        "$@" </dev/null 2>&1 | tee "$log"
        return "${PIPESTATUS[0]}"
    fi

    "$@" >"$log" 2>&1 </dev/null &
    local pid=$! i=0 rc=0 start=$SECONDS elapsed
    local -a frames=('|' '/' '-' $'\x5c')

    printf '\e[?25l'
    while kill -0 "$pid" 2>/dev/null; do
        elapsed=$(( SECONDS - start ))
        printf '\r    %s%s%s %s  %s%dm%02ds%s' \
            "$C_B" "${frames[i++ % 4]}" "$C_0" "$label" \
            "$C_D" $(( elapsed / 60 )) $(( elapsed % 60 )) "$C_0"
        sleep 0.2
    done
    wait "$pid"; rc=$?
    elapsed=$(( SECONDS - start ))
    printf '\r\e[2K\e[?25h'

    [[ $rc -eq 0 ]] && ok "$label  ${C_D}($(( elapsed / 60 ))m$(( elapsed % 60 ))s)${C_0}"
    return $rc
}

# ── questions ─────────────────────────────────────────────────────────────────
ask_disk() {
    step "Which disk should Arch be installed on?"
    say  "    ${C_R}Everything on the disk you pick will be erased.${C_0}"
    say
    local -a devs=()
    # zram reports TYPE=disk, so filtering on type alone offers compressed RAM
    # swap as an install target. Exclude it by name along with the other
    # pseudo-devices, and drop read-only ones (the install medium itself).
    #
    # lsblk escapes spaces in MODEL as \x20, so "Samsung SSD 870" arrives as
    # "Samsung\x20SSD\x20870". Decode it or the menu is unreadable.
    # TYPE comes first so MODEL can be last: read gives the final variable
    # everything remaining, and a model name contains spaces.
    while read -r _type name bytes ro model; do
        [[ $ro == 1 ]] && continue
        [[ ${bytes:-x} =~ ^[0-9]+$ ]] || continue
        # Too small to install onto: an emulated floppy (/dev/fd0, which QEMU
        # always presents), an empty card reader slot. Skipping them is not
        # only tidiness — every one of them takes a number in the list, so the
        # disk someone means to choose is not the number they reach for.
        [[ $bytes -lt $((4 * 1024 * 1024 * 1024)) ]] && continue
        model="${model//\\x20/ }"
        devs+=("$name")
        printf '      %-2s %-12s %-8s %s\n' "${#devs[@]})" "$name" \
               "$(numfmt --to=iec "$bytes")" "${model:-—}"
    done < <(lsblk -b -dpnro TYPE,NAME,SIZE,RO,MODEL |
             awk '$1=="disk"' |
             grep -vE " /dev/(loop|sr|ram|zram|md|dm-|fd)")
    [[ ${#devs[@]} -gt 0 ]] || die "no usable disks found"
    say
    local n
    read -rp "    Disk [1-${#devs[@]}]: " n
    DISK="${devs[$((n-1))]:-}"
    [[ -b ${DISK:-} ]] || die "not a disk: ${DISK:-<none>}"

    say
    say "    ${C_Y}$DISK currently contains:${C_0}"
    lsblk -pno NAME,SIZE,FSTYPE,LABEL "$DISK" | sed 's/^/      /'
    say
    local confirm
    read -rp "    Type ERASE to wipe $DISK: " confirm
    [[ $confirm == ERASE ]] || die "not confirmed"
}

ask_rest() {
    step "A few more things"
    read -rp "    Hostname [starch]: " HOSTNAME_; HOSTNAME_="${HOSTNAME_:-starch}"

    while :; do
        read -rp "    Your username: " USERNAME
        [[ $USERNAME =~ ^[a-z_][a-z0-9_-]*$ ]] && break
        warn "lowercase letters, digits, - and _ only"
    done

    local p1 p2
    while :; do
        read -rsp "    Password for $USERNAME: " p1; say
        read -rsp "    Repeat it: " p2; say
        [[ -n $p1 && $p1 == "$p2" ]] && { PASSWORD="$p1"; break; }
        warn "empty or does not match"
    done

    read -rp "    Timezone [UTC]: " TIMEZONE; TIMEZONE="${TIMEZONE:-UTC}"
    [[ -f /usr/share/zoneinfo/$TIMEZONE ]] || { warn "unknown timezone, using UTC"; TIMEZONE=UTC; }

    read -rp "    Filesystem — 1) ext4  2) btrfs  [1]: " fs
    case "${fs:-1}" in 2) FSTYPE=btrfs ;; *) FSTYPE=ext4 ;; esac

    read -rp "    Keyboard layout [us]: " KBLAYOUT; KBLAYOUT="${KBLAYOUT:-us}"
}

# ── partition ─────────────────────────────────────────────────────────────────
# One scheme, deliberately: GPT, a 1GiB EFI system partition, and root filling
# the rest. Anyone who wants LVM, RAID or a separate /home is better served by
# archinstall directly, which the menu still offers.
partition_disk() {
    step "Partitioning $DISK"

    wipefs -af "$DISK" >/dev/null 2>&1
    sgdisk --zap-all "$DISK" >/dev/null 2>&1
    sgdisk --clear \
        --new=1:0:+1GiB --typecode=1:ef00 --change-name=1:EFI \
        --new=2:0:0     --typecode=2:8300 --change-name=2:starch \
        "$DISK" >/dev/null || die "partitioning failed"
    partprobe "$DISK" 2>/dev/null
    udevadm settle 2>/dev/null

    # nvme0n1 partitions are nvme0n1p1; sda partitions are sda1.
    local sep=""; [[ $DISK =~ [0-9]$ ]] && sep=p
    ESP="${DISK}${sep}1"
    ROOT="${DISK}${sep}2"

    # udevadm settle usually suffices, but device nodes can lag the kernel
    # re-reading the table, and failing here means a wiped disk and no install.
    # Wait a few seconds before giving up rather than losing on a race.
    local waited=0
    until [[ -b $ESP && -b $ROOT ]]; do
        sleep 1; waited=$((waited + 1))
        [[ $waited -ge 10 ]] && die "$ESP and $ROOT did not appear after partitioning $DISK"
    done
    ok "$ESP (EFI, 1GiB) and $ROOT (root, rest)"

    step "Formatting"
    mkfs.fat -F32 -n EFI "$ESP" >/dev/null || die "mkfs.fat failed"
    case "$FSTYPE" in
        btrfs) mkfs.btrfs -f -L starch "$ROOT" >/dev/null || die "mkfs.btrfs failed" ;;
        *)     mkfs.ext4 -F -L starch "$ROOT" >/dev/null || die "mkfs.ext4 failed" ;;
    esac
    ok "$FSTYPE on $ROOT, fat32 on $ESP"

    step "Mounting at $TARGET"
    mountpoint -q "$TARGET" && umount -R "$TARGET" 2>/dev/null
    mkdir -p "$TARGET"
    if [[ $FSTYPE == btrfs ]]; then
        # The @ subvolume is what archinstall and most guides use, so a system
        # installed here looks like any other btrfs Arch install.
        mount "$ROOT" "$TARGET" || die "mount failed"
        btrfs subvolume create "$TARGET/@" >/dev/null || die "could not create @"
        umount "$TARGET"
        mount -o subvol=@ "$ROOT" "$TARGET" || die "mount of @ failed"
    else
        mount "$ROOT" "$TARGET" || die "mount failed"
    fi
    mkdir -p "$TARGET/boot"
    mount "$ESP" "$TARGET/boot" || die "could not mount the ESP"
    ok "mounted"
    findmnt -nR "$TARGET" -o TARGET,SOURCE | sed 's/^/      /'
}

# ── archinstall ───────────────────────────────────────────────────────────────
# Everything that can fail while the disk is still intact happens here. The
# order matters more than it looks: partitioning is irreversible, so a missing
# tool or an unhashable password must stop the install before the wipe rather
# than halfway through, leaving a machine with no OS and no installer state.
prepare_config() {
    step "Checking tools and preparing the configuration"

    local missing=()
    for t in sgdisk wipefs partprobe mkfs.fat openssl archinstall arch-chroot python3; do
        command -v "$t" >/dev/null || missing+=("$t")
    done
    [[ $FSTYPE == btrfs ]] && { command -v mkfs.btrfs >/dev/null || missing+=(mkfs.btrfs); }
    [[ $FSTYPE == ext4  ]] && { command -v mkfs.ext4  >/dev/null || missing+=(mkfs.ext4);  }
    [[ ${#missing[@]} -eq 0 ]] || die "missing on this medium: ${missing[*]}"
    ok "all required tools present"

    [[ -d $REPO_SRC ]] || die "the setup is missing from $REPO_SRC"
    ok "setup found at $REPO_SRC"

    # A missing network is not a visible failure further down. archinstall
    # answers a failed connectivity check by opening its wifi prompt, and with
    # no wifi device it returns 0 having installed nothing — which looks like a
    # successful install until the machine will not boot. Check it here, while
    # the disk is still intact.
    local waited=0
    until timeout 4 bash -c 'exec 3<>/dev/tcp/archlinux.org/443' 2>/dev/null; do
        waited=$((waited + 5))
        if [[ $waited -ge 40 ]]; then
            err "no network"
            say "    The install downloads packages, so it cannot run offline."
            say "    Plug in a cable, or connect wifi with:  iwctl"
            say "    Then start again. Nothing has been written to the disk."
            exit 1
        fi
        sleep 1
    done
    ok "network is up"

    mkdir -p "$WORK"

    local hash
    hash="$(openssl passwd -6 "$PASSWORD")" || die "could not hash the password"

    HOSTNAME_="$HOSTNAME_" TIMEZONE="$TIMEZONE" KBLAYOUT="$KBLAYOUT" \
    USERNAME="$USERNAME" PWHASH="$hash" WORK="$WORK" \
    python3 - <<'PY'
import json, os

work = os.environ["WORK"]

# pre_mounted_config: the filesystems are already mounted at /mnt, so
# archinstall installs onto them rather than partitioning anything itself.
config = {
    "archinstall-language": "English",
    "disk_config": {"config_type": "pre_mounted_config", "mountpoint": "/mnt"},
    "bootloader_config": {"bootloader": "Systemd-boot", "uki": False, "removable": False},
    "hostname": os.environ["HOSTNAME_"],
    "kernels": ["linux"],
    "locale_config": {"kb_layout": os.environ["KBLAYOUT"], "sys_enc": "UTF-8", "sys_lang": "en_US"},
    "network_config": {"type": "nm"},
    "audio_config": {"audio": "pipewire"},
    "ntp": True,
    "timezone": os.environ["TIMEZONE"],
    "swap": {"enabled": True, "algorithm": "zstd"},
    # The desktop is installed by install.sh afterwards, so archinstall lays
    # down a minimal base and nothing opinionated on top of it.
    "profile_config": {"profile": {"main": "Minimal"}},
    "packages": ["base-devel", "git", "sudo", "networkmanager"],
    "no_pkg_lookups": False,
    "offline": False,
    "silent": True,
    "script": "guided",
    "version": "2.8.6",
}

creds = {
    "users": [{"username": os.environ["USERNAME"],
               "enc_password": os.environ["PWHASH"],
               "sudo": True}],
}

json.dump(config, open(f"{work}/config.json", "w"), indent=2)
json.dump(creds, open(f"{work}/creds.json", "w"), indent=2)
PY
    chmod 600 "$WORK/creds.json"
    python3 -c "import json,sys; json.load(open('$WORK/config.json')); json.load(open('$WORK/creds.json'))" \
        || die "generated configuration is not valid JSON"
    ok "config.json and creds.json written and parse cleanly"
}

# archinstall can fail without saying much on screen, so put the evidence in
# front of whoever is standing at the machine rather than describing where to
# look for it.
show_logs() {
    local out="$1" extra="${2:-}"
    if [[ -s $out ]]; then
        say
        say "    ${C_D}--- last 25 lines of $out ---${C_0}"
        tail -25 "$out" | sed 's/^/      /'
    fi
    if [[ -n $extra && -s $extra ]]; then
        say
        say "    ${C_D}--- last 25 lines of $extra ---${C_0}"
        tail -25 "$extra" | sed 's/^/      /'
    fi
    say
    say "    Full output: $out"
    say "    The configuration it was given is at $WORK/config.json."
}

run_archinstall() {
    step "Installing Arch"
    say "    ${C_D}Detail goes to $WORK/archinstall.out — Alt+F2 for a shell to watch it.${C_0}"
    say
    # --skip-wifi-check: this runs unattended, and archinstall's wifi prompt is
    # interactive. Without it a connectivity hiccup turns into a TUI nobody is
    # there to answer.
    #
    # The output is kept because archinstall declines a configuration in a
    # single line and then exits successfully; that line is the only evidence.
    local out="$WORK/archinstall.out"
    if ! spin "Installing the base system" "$out" \
              archinstall --config "$WORK/config.json" --creds "$WORK/creds.json" \
                          --silent --skip-wifi-check; then
        err "archinstall failed"
        say "    $TARGET is left mounted so you can look around."
        show_logs "$out" /var/log/archinstall/install.log
        return 1
    fi

    # Exit status 0 is not evidence that anything was installed: archinstall
    # returns 0 after doing nothing when it does not like the configuration.
    # Check for a system that actually exists before claiming success.
    local missing=()
    for f in /etc/passwd /etc/fstab /usr/bin/pacman /usr/lib/systemd/systemd; do
        [[ -e "$TARGET$f" ]] || missing+=("$f")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "archinstall exited successfully but did not install a system"
        say "    missing from $TARGET: ${missing[*]}"
        show_logs "$out" /var/log/archinstall/install.log
        return 1
    fi
    ok "base system installed"
}

# ── the desktop ───────────────────────────────────────────────────────────────
install_desktop() {
    step "Installing the Hyprland desktop"

    mountpoint -q "$TARGET" || die "$TARGET is not mounted; cannot continue"
    local home="/home/$USERNAME"
    [[ -d "$TARGET$home" ]] || die "$TARGET$home does not exist — archinstall did not create the user"

    cp -r "$REPO_SRC" "$TARGET$home/hyprland-setup" || die "could not copy the setup"
    cp /etc/resolv.conf "$TARGET/etc/resolv.conf" 2>/dev/null || true
    ok "setup copied to $home/hyprland-setup"

    local out="$WORK/desktop.out"
    say "    ${C_D}This is the long one — it downloads and installs the desktop.${C_0}"
    say
    # Invoked through bash rather than executed: mkarchiso copies the ISO
    # payload with --no-preserve=mode, so install.sh arrives here without its
    # execute bit and chroot answers with a bare "Permission denied".
    if ! spin "Installing the desktop" "$out" \
              arch-chroot "$TARGET" bash "$home/hyprland-setup/install.sh" \
                          --for-user "$USERNAME"; then
        err "the desktop install failed"
        show_logs "$out"
        say "    Arch itself is installed and bootable. To retry:"
        say "      arch-chroot $TARGET bash $home/hyprland-setup/install.sh --for-user $USERNAME"
        return 1
    fi
}

# ── main ──────────────────────────────────────────────────────────────────────
clear
cat <<'EOF'

      _             _
  ___| |_ __ _ _ __| |__
 / __| __/ _` | '__| '_ \
 \__ \ || (_| | |  | | | |
 |___/\__\__,_|_|  |_| |_|

 A guided install of Arch Linux with the Hyprland desktop.
 Six questions, then it runs on its own.

EOF
read -rp "  Continue? [y/N] " a; [[ ${a,,} == y ]] || exit 0

ask_disk
ask_rest

step "Ready"
say "    disk       $DISK  (${FSTYPE}, will be erased)"
say "    hostname   $HOSTNAME_"
say "    user       $USERNAME"
say "    timezone   $TIMEZONE"
say "    keyboard   $KBLAYOUT"
say
read -rp "    Start the install? [y/N] " a; [[ ${a,,} == y ]] || exit 0

# Nothing before this line touches the disk.
prepare_config   || exit 1
partition_disk   || exit 1
run_archinstall  || exit 1
install_desktop  || exit 1

step "Done"
say "    Arch and Hyprland are installed."
say "    Log in as $USERNAME after rebooting."
say
read -rp "    Reboot now? [y/N] " a
if [[ ${a,,} == y ]]; then
    umount -R "$TARGET" 2>/dev/null
    reboot
fi
