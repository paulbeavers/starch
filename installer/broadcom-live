#!/usr/bin/env bash
# Put the right Broadcom wireless driver in charge, in the live session.
#
# The installed system gets this from install.sh, which writes a modprobe
# blacklist while configuring the desktop. The live medium cannot: it has to
# work on hardware it only meets at boot, and by the time anything runs the
# kernel has already bound whatever driver claimed the card first.
#
# So this looks at what is actually there, and only acts on the cards where the
# in-kernel drivers are the wrong answer. Everything else is left alone —
# brcmfmac handles most modern Broadcom parts perfectly well, and blacklisting
# it wholesale would break wifi on the machines that are currently fine.
#
# Runs once at boot, before the network daemons start.
set -uo pipefail

# The same list install.sh uses. Cards the in-kernel drivers cannot drive, or
# drive worse than the proprietary wl module.
#   43a0 BCM4360 (2013 retina MacBook Pro)   4331 BCM4331 (older MacBook Pro)
#   43b1 BCM4352   432b BCM4322   4353 BCM43224   4315 BCM4312
#
# Check any addition against brcmfmac's own alias table first:
#
#     modinfo brcmfmac | grep -oiE 'd0000[0-9A-F]{4}'
#
# 43ba (BCM43602) and 43a3 (BCM4350) used to be here and are claimed by
# brcmfmac, which ships their firmware too. Listing them blacklisted the
# driver that works and loaded wl, which cannot bind them. A 2013 15" MacBook
# Pro is a BCM43602 and had no wireless at all as a result.
WL_IDS=(0x43a0 0x4331 0x43b1 0x432b 0x4353 0x4315)

found=""
seen=()
for dev in /sys/bus/pci/devices/*; do
    [[ -r $dev/vendor && -r $dev/device ]] || continue
    [[ "$(cat "$dev/vendor")" == 0x14e4 ]] || continue
    id="$(cat "$dev/device")"
    seen+=("${id#0x}")
    for want in "${WL_IDS[@]}"; do
        [[ $id == "$want" ]] && { found="$id"; break 2; }
    done
done

# Leaving an unlisted card to the in-kernel drivers is deliberate, but it used
# to be indistinguishable from having no Broadcom card at all: both exited 0
# with nothing logged. When wireless then does not work, this is the one line
# that says which of the two happened, and names the id to add to WL_IDS.
if [[ -z $found ]]; then
    if (( ${#seen[@]} )); then
        logger -t starch-broadcom \
            "Broadcom ${seen[*]} present, none on the wl list; keeping wl away from it"
        # Not merely "do nothing". wl matches on PCI *class* —
        #
        #     alias: pci:v*d*sv*sd*bc02sc80i*
        #
        # "any other network controller" — so udev autoloads it for a card it
        # has no business driving, alongside the in-kernel driver that does,
        # and whichever binds first wins. On a BCM43602 a win for wl means a
        # card with a driver that cannot carry traffic. Taking the card off
        # the wl list was only half the fix; this is the half that makes the
        # in-kernel driver win every time instead of most of the time.
        cat > /etc/modprobe.d/starch-broadcom.conf <<'CONF'
# Written at boot by starch: this machine's Broadcom card is handled by the
# in-kernel driver. wl claims cards by PCI class rather than by device id, so
# it would otherwise race for this one and cannot drive it.
blacklist wl
CONF
        modprobe -r wl 2>/dev/null || true
        modprobe brcmfmac 2>/dev/null || true
    else
        logger -t starch-broadcom "no Broadcom card on this machine; nothing to do"
    fi
    exit 0
fi

logger -t starch-broadcom "Broadcom ${found#0x} needs the wl driver; switching"

# For any later boot of this medium, and so the state is visible.
cat > /etc/modprobe.d/starch-broadcom.conf <<'CONF'
# Written at boot by starch: this machine has a Broadcom card the in-kernel
# drivers cannot drive. bcma and ssb are the buses they attach through.
blacklist b43
blacklist bcma
blacklist brcmsmac
blacklist brcmfmac
blacklist ssb
CONF

# The blacklist only governs what loads next. Something has very likely bound
# the card already, and it has to let go before wl can take it.
for mod in brcmfmac brcmsmac b43 bcma ssb; do
    modprobe -r "$mod" 2>/dev/null || true
done

modprobe wl 2>/dev/null \
    || logger -t starch-broadcom "wl would not load; wireless will not work here"
