/* starch installer. Catppuccin Mocha comes from the theme; this is layout.
 *
 * Everything sits in a centred frame with a ceiling on its size, so a 120x37
 * retina console and a 240x67 4K one show the same installer, not one
 * stretched across the screen. */

Screen {
    background: $background;
}

/* kmscon draws block elements shorter than the cell, so Textual's default
 * "tall" and "thick" borders, which are made of them, break into stubs down
 * each side. Box-drawing borders join up; every bordered widget uses one. */
Input, RadioSet, Switch { border: round $primary 30%; }
Input:focus, RadioSet:focus, Switch:focus { border: round $primary; }

.hidden { display: none; }

/* ── welcome ─────────────────────────────────────────────────────────────── */

#logo {
    color: $primary;
    text-style: bold;
    width: auto;
    margin-bottom: 1;
}
#tagline { color: $text; text-style: bold; margin-bottom: 1; }
#machine { color: $text-muted; margin-bottom: 2; }
#intro { color: $text-muted; width: auto; text-align: center; margin-bottom: 2; }
#welcome-buttons { height: auto; width: auto; }
#welcome-buttons Button { margin: 0 2; min-width: 16; }

/* ── the frame the wizard and the install share ──────────────────────────── */

#frame-wrap {
    height: 1fr;
    align: center middle;
}
#frame, #install-frame {
    width: 100%;
    max-width: 118;
    height: 100%;
    max-height: 40;
    border: round $primary;
    background: $surface;
    margin: 1 2;
}

#sidebar {
    width: 22;
    height: 100%;
    padding: 1 2;
    border-right: solid $primary 40%;
    background: $panel;
}

#main {
    padding: 1 3;
}
#install-frame { padding: 1 3; }

#heading { text-style: bold; color: $text; }
#subheading { color: $text-muted; margin-bottom: 1; }
#problem { color: $error; text-style: bold; height: auto; min-height: 1; margin-top: 1; }

#pages { height: 1fr; }
.page { height: 1fr; }

#nav {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}
#nav Button { margin-left: 2; min-width: 14; }
#nav #next { min-width: 24; }   /* "Erase and install" on the review page */

/* ── keyboard ────────────────────────────────────────────────────────────── */

#keymaps, #keymap-all { height: 1fr; border: round $primary 30%; }
#keymaps:focus, #keymap-all:focus { border: round $primary; }
#keymap-search { margin-bottom: 1; }
#keytest { margin-top: 1; }

/* ── disk ────────────────────────────────────────────────────────────────── */

#disks { height: auto; max-height: 8; border: round $primary 30%; }
#disks:focus { border: round $primary; }
#disk-contents { height: auto; max-height: 6; padding: 0 1; margin: 1 0; }
#disk-options { height: auto; margin-top: 1; }
#mode { width: auto; }
.optgroup { width: 1fr; height: auto; padding-right: 2; }
.optlabel { color: $text-muted; margin-bottom: 1; }
RadioSet { width: 100%; }

/* ── account ─────────────────────────────────────────────────────────────── */

.row { height: auto; }   /* each field has its own label line; a gap as well overflowed 120x37 */
.field { width: 1fr; height: auto; padding-right: 2; }
.flabel { color: $text-muted; }
.flabel.inline { width: auto; padding: 1 2 0 0; }
#timezones { height: 7; border: round $primary 30%; }
#timezones:focus { border: round $primary; }

/* ── review ──────────────────────────────────────────────────────────────── */

#review { height: auto; border: round $primary 30%; padding: 0 1; overflow: hidden hidden; }
#warning { margin-top: 1; height: auto; }

/* ── dialogs ─────────────────────────────────────────────────────────────── */

Confirm { align: center middle; background: $background 60%; }
#dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: heavy $primary;
    background: $surface;
}
#dialog.danger { border: heavy $error; }
#dialog-title { text-style: bold; margin-bottom: 1; }
#dialog-body { color: $text-muted; margin-bottom: 1; }
#dialog-buttons { height: auto; align-horizontal: right; }
#dialog-buttons Button { margin-left: 2; }

/* ── installing ──────────────────────────────────────────────────────────── */

#progress { margin-bottom: 1; width: 100%; }
#progress Bar { width: 1fr; }
#install-body { height: 1fr; }
#steps { width: 42; height: 100%; padding: 1 1; border-right: solid $primary 40%; }
#log {
    height: 100%;
    padding: 0 1;
    background: $background;
    color: $text-muted;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}
#status { margin-top: 1; height: auto; text-style: bold; }
#done-buttons { height: auto; align-horizontal: right; margin-top: 1; }
#done-buttons Button { margin-left: 2; min-width: 14; }
