#!/usr/bin/env bash
# starch installer.
#
# Asks its questions up front, shows them back as a summary, then installs Arch
# with pacstrap and runs install.sh --for-user in a chroot. That is the same
# thing a person following the Arch install guide does before cloning the
# desktop and running install.sh, which is the point: the result is a native
# Arch system with the desktop on it, not a copy of this medium with the live
# parts picked back out.
#
# Offline. The medium carries every package the install can ask for as pacman
# repositories under /usr/share/starch: the official core and extra databases
# exactly as build.sh synced them, with the packages they need beside them, and
# starch-local for the few from the AUR. pacstrap and install.sh read them
# through file:// servers, verify signatures against the official databases as
# they would from a mirror, and the installed system is pointed at real mirrors
# before it is handed over.
#
# Runs as root on tty1 of the medium. gum draws the questions; the install
# itself is plain output, because that is what stays readable on a console
# whose font is whatever the kernel loaded.
set -uo pipefail

LUCENT_SRC=/usr/local/share/lucent
REPO=/usr/share/starch/repo         # core.db, extra.db and their packages
LOCALREPO=/usr/share/starch/local   # starch-local.db, from the AUR
TARGET=/mnt
WORK=/run/starch
LOG=/var/log/starch-install.log
MAPPER=root                         # /dev/mapper/root when encrypted

ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b

C_B=$'\e[1;34m'; C_G=$'\e[1;32m'; C_Y=$'\e[1;33m'; C_R=$'\e[1;31m'; C_D=$'\e[2m'; C_0=$'\e[0m'
say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s\n' "$C_B" "$C_0" "$*"; }
ok()   { printf '    %s✓%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '    %s!%s %s\n' "$C_Y" "$C_0" "$*"; }
err()  { printf '\n%sERROR:%s %s\n' "$C_R" "$C_0" "$*" >&2; }
die()  { err "$*"; exit 1; }

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
command -v gum >/dev/null || die "gum is not installed; the installer needs it to draw its questions."

# spin() hides the cursor. Put it back on any exit, including Ctrl-C.
trap 'printf "\e[?25h"' EXIT

# ── look ──────────────────────────────────────────────────────────────────────
# Colours by ANSI number, not hex. The Linux console has sixteen, and lipgloss
# maps anything else to the nearest of them, which is not always near. 4 is
# blue, 8 grey, 3 yellow, 1 red. Borders are "normal" rather than "rounded":
# the arcs are missing from most console fonts and come out as blocks.
export GUM_CHOOSE_CURSOR_FOREGROUND=4 GUM_CHOOSE_SELECTED_FOREGROUND=4
export GUM_CHOOSE_HEADER_FOREGROUND=7
export GUM_INPUT_CURSOR_FOREGROUND=4 GUM_INPUT_PROMPT_FOREGROUND=4
export GUM_INPUT_HEADER_FOREGROUND=7
export GUM_FILTER_INDICATOR_FOREGROUND=4 GUM_FILTER_MATCH_FOREGROUND=4
export GUM_FILTER_HEADER_FOREGROUND=7 GUM_FILTER_PROMPT_FOREGROUND=4
export GUM_CONFIRM_SELECTED_BACKGROUND=4 GUM_CONFIRM_PROMPT_FOREGROUND=7

# A console font the panel can be read at. The kernel's 8x16 on a 2880x1800
# retina MacBook Pro is a few millimetres tall; the 13" at 2560x1600 is no
# better. Terminus comes in sizes up to 32 and is on the medium already.
# CONSOLE_FONT is also written into the installed system's vconsole.conf, so
# its console and the disk passphrase prompt are just as readable.
CONSOLE_FONT=""
pick_console_font() {
    local w
    w=$(cut -d, -f1 /sys/class/graphics/fb0/virtual_size 2>/dev/null)
    [[ $w =~ ^[0-9]+$ ]] || return 0
    if   [[ $w -ge 2560 ]]; then CONSOLE_FONT=ter-v32b
    elif [[ $w -ge 1920 ]]; then CONSOLE_FONT=ter-v24b
    fi
    [[ -n $CONSOLE_FONT ]] && setfont "$CONSOLE_FONT" 2>/dev/null || CONSOLE_FONT=""
}

banner() {
    clear
    gum style --foreground 4 --bold --margin "1 2" <<'LOGO'
     _                 _
 ___| |_ __ _ _ __ ___| |__
/ __| __/ _` | '__/ __| '_ \
\__ \ || (_| | | | (__| | | |
|___/\__\__,_|_|  \___|_| |_|
LOGO
    gum style --foreground 8 --margin "0 2 1 2" "Arch Linux + Hyprland"
}

note()  { gum style --foreground 8 --margin "0 2" "$@"; }
alert() { gum style --foreground 3 --border normal --border-foreground 3 \
                    --padding "0 1" --margin "1 2" "$@"; }

# A question that has to be answered correctly before moving on. gum returns
# non-zero on Esc or Ctrl-C, which here means "leave the installer".
#
# These run inside $(...), so a plain exit would only end the subshell and the
# installer would carry on with an empty answer. The main shell is signalled
# instead; $$ is its pid even from inside a subshell.
trap 'clear; say "Nothing was changed."; exit 0' USR1
quit_check() {
    if gum confirm --default=false --affirmative "Quit" --negative "Keep going" \
           "Leave the installer? Nothing has been written to any disk."; then
        kill -USR1 $$; exit 0
    fi
}
input() {
    local v
    while :; do
        v=$(gum input "$@") && { printf '%s' "$v"; return; }
        quit_check
    done
}
choose() {
    local v
    while :; do
        v=$(gum choose "$@") && { printf '%s' "$v"; return; }
        quit_check
    done
}
filter() {
    local v
    while :; do
        v=$(gum filter "$@") && [[ -n $v ]] && { printf '%s' "$v"; return; }
        quit_check
    done
}

# ── questions ─────────────────────────────────────────────────────────────────
# Every answer lives in ANS. Each ask_ function can be called again from the
# summary, so it offers the previous answer as its starting value.
declare -A ANS

ask_keyboard() {
    banner
    ANS[keymap]=$(filter --header "Keyboard layout" --placeholder "type to search, e.g. us, uk, de" \
                         --value "${ANS[keymap]:-}" --height 15 < <(localectl list-keymaps))
    loadkeys "${ANS[keymap]}" 2>/dev/null || true
}

# Disks only: not the medium itself, not loop devices or optical drives, and
# nothing too small to hold the desktop.
list_disks() {
    local boot_dev
    boot_dev=$(findmnt -nvo SOURCE /run/archiso/bootmnt 2>/dev/null | sed 's/[0-9]*$//; s/p$//')
    lsblk -b -dpnro TYPE,NAME,SIZE,RO,MODEL |
        awk '$1=="disk" && $4==0' |
        grep -vE " /dev/(loop|sr|ram|zram|fd)" |
        while read -r _ name bytes _ model; do
            [[ $name == "$boot_dev" ]] && continue
            [[ $bytes -lt $((20 * 1024 ** 3)) ]] && continue
            printf '%s  %s  %s\n' "$name" "$(numfmt --to=iec "$bytes")" "${model//\\x20/ }"
        done
}

ask_disk() {
    banner
    local -a disks
    mapfile -t disks < <(list_disks)
    if [[ ${#disks[@]} -eq 0 ]]; then
        alert "No disk of 20 GiB or more was found to install onto."
        exit 1
    fi
    local sel
    sel=$(choose --header "Install onto which disk?" "${disks[@]}")
    ANS[disk]="${sel%% *}"
    ANS[mode]=""
}

# Largest unallocated block, in bytes, by sgdisk's own reckoning — the same
# block sgdisk -n 0:0:... will use, so what is shown is what gets used.
largest_free() {
    local disk="$1" ss first last
    ss=$(blockdev --getss "$disk")
    first=$(sgdisk -F "$disk" 2>/dev/null) || { echo 0; return; }
    last=$(sgdisk -E "$disk" 2>/dev/null)  || { echo 0; return; }
    [[ $first =~ ^[0-9]+$ && $last =~ ^[0-9]+$ && $last -gt $first ]] || { echo 0; return; }
    echo $(( (last - first + 1) * ss ))
}

ask_mode() {
    banner
    local disk="${ANS[disk]}" pttype free
    note "$(lsblk -po NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$disk")"
    say

    # Installing alongside needs a GPT table and room on it. The free space is
    # used as it is: nothing is ever shrunk or moved, so making room is the
    # other system's job, with its own tools, before starting here.
    pttype=$(blkid -po value -s PTTYPE "$disk" 2>/dev/null)
    free=0
    [[ $pttype == gpt ]] && free=$(largest_free "$disk")

    local -a opts=("Erase the whole disk")
    if [[ $free -ge $((20 * 1024 ** 3)) ]]; then
        opts+=("Use the $(numfmt --to=iec "$free") of free space, keep everything else")
    fi
    local sel
    sel=$(choose --header "How should $disk be used?" "${opts[@]}")
    case $sel in
        Erase*) ANS[mode]=erase ;;
        *)      ANS[mode]=alongside; ANS[free]=$free ;;
    esac
    if [[ ${#opts[@]} -eq 1 && $pttype == gpt ]]; then
        note "Installing alongside another system needs 20 GiB of unallocated space on the disk."
    fi
}

ask_filesystem() {
    banner
    local sel
    sel=$(choose --header "Filesystem" \
                 "ext4   plain and predictable" \
                 "btrfs  subvolumes @ and @home, compressed, ready for snapshots")
    ANS[fstype]="${sel%% *}"
}

ask_encrypt() {
    banner
    if gum confirm --default=false --affirmative "Encrypt" --negative "No" \
           "Encrypt the disk? It will ask for a passphrase at every boot."; then
        ANS[encrypt]=yes
    else
        ANS[encrypt]=no
    fi
}

ask_hostname() {
    banner
    local v
    while :; do
        v=$(input --header "A name for this machine on the network" \
                  --value "${ANS[hostname]:-starch}")
        v="${v:-starch}"
        [[ $v =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] && break
        note "Letters, digits and hyphens only, not starting with a hyphen."
    done
    ANS[hostname]="$v"
}

ask_user() {
    banner
    local v
    while :; do
        v=$(input --header "Your username" --placeholder "lowercase, e.g. alex" \
                  --value "${ANS[username]:-}")
        [[ $v =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && ! getent passwd "$v" >/dev/null && break
        note "Start with a lowercase letter; then lowercase letters, digits, - and _."
    done
    ANS[username]="$v"
}

# Asked twice, and never shown. The disk passphrase defaults to the same one,
# which is what most people want and what saves typing two secrets at boot.
ask_password() {
    banner
    local p1 p2
    while :; do
        p1=$(input --password --header "Password for ${ANS[username]}")
        p2=$(input --password --header "Type it again")
        [[ -n $p1 && $p1 == "$p2" ]] && break
        note "$( [[ -z $p1 ]] && echo "The password cannot be empty." || echo "Those did not match.")"
    done
    ANS[password]="$p1"

    ANS[passphrase]=""
    [[ ${ANS[encrypt]} == yes ]] || return 0
    if gum confirm --affirmative "Same password" --negative "A different one" \
           "Unlock the disk with the same password?"; then
        ANS[passphrase]="$p1"
        return
    fi
    while :; do
        p1=$(input --password --header "Disk passphrase")
        p2=$(input --password --header "Type it again")
        [[ -n $p1 && $p1 == "$p2" ]] && break
        note "$( [[ -z $p1 ]] && echo "The passphrase cannot be empty." || echo "Those did not match.")"
    done
    ANS[passphrase]="$p1"
}

ask_timezone() {
    banner
    ANS[timezone]=$(filter --header "Timezone" --placeholder "type to search, e.g. Chicago, London" \
                           --value "${ANS[timezone]:-}" --height 15 \
                           < <(timedatectl list-timezones 2>/dev/null || echo UTC))
}

# Draws the summary. The choice that follows it is made by the caller: inside
# $(...) everything drawn here would be captured instead of shown.
summary() {
    banner
    local where
    case ${ANS[mode]} in
        erase)     where="${ANS[disk]}  (everything on it will be erased)" ;;
        alongside) where="${ANS[disk]}  ($(numfmt --to=iec "${ANS[free]}") of free space; nothing else touched)" ;;
    esac
    gum style --border normal --border-foreground 4 --padding "1 2" --margin "0 2" \
        "$(printf '%-11s %s\n' \
            Disk       "$where" \
            Filesystem "${ANS[fstype]}$( [[ ${ANS[encrypt]} == yes ]] && echo ', encrypted')" \
            Hostname   "${ANS[hostname]}" \
            User       "${ANS[username]}" \
            Timezone   "${ANS[timezone]}" \
            Keyboard   "${ANS[keymap]}")"
    say
}

change_something() {
    local sel
    sel=$(choose --header "Change which?" Disk Filesystem Encryption Hostname User Password Timezone Keyboard "Back to summary")
    case $sel in
        Disk)       ask_disk; ask_mode ;;
        Filesystem) ask_filesystem ;;
        Encryption) ask_encrypt; ask_password ;;
        Hostname)   ask_hostname ;;
        User)       ask_user; ask_password ;;
        Password)   ask_password ;;
        Timezone)   ask_timezone ;;
        Keyboard)   ask_keyboard ;;
    esac
}

run_questions() {
    banner
    note "This installs Arch Linux with the Hyprland desktop. It needs no network." \
         "" \
         "You will be asked a few things, then shown them all again." \
         "Nothing is written to any disk until you choose Install."
    say
    choose "Begin" "Quit" | grep -q Begin || { clear; exit 0; }

    ask_keyboard; ask_disk; ask_mode; ask_filesystem; ask_encrypt
    ask_hostname; ask_user; ask_password; ask_timezone
    while :; do
        summary
        case $(choose --header "Ready?" "Install" "Change something" "Quit") in
            Install) break ;;
            Quit)    clear; say "Nothing was changed."; exit 0 ;;
            *)       change_something ;;
        esac
    done

    # The one irreversible choice gets its own question, worded so it cannot be
    # mistaken for the summary's.
    if [[ ${ANS[mode]} == erase ]]; then
        banner
        alert "Everything on ${ANS[disk]} will be erased." \
              "" "$(lsblk -po NAME,SIZE,FSTYPE,LABEL "${ANS[disk]}")"
        gum confirm --default=false --affirmative "Erase it" --negative "Cancel" \
            "Erase ${ANS[disk]} and install?" || { clear; say "Nothing was changed."; exit 0; }
    fi
}

# ── running things ────────────────────────────────────────────────────────────
# Run something slow with its output in the log instead of on the screen,
# showing one line that says it is still going. On failure the end of the log
# is put in front of whoever is at the machine rather than described.
#
# stdin is /dev/null: nothing here should ask a question, and if something does
# it gets EOF and fails rather than waiting for an answer nobody can see.
#
# ASCII frames: braille spinners are blanks on the console font.
spin() {
    local label="$1"; shift
    printf '\n--- %s\n' "$label" >>"$LOG"
    "$@" >>"$LOG" 2>&1 </dev/null &
    local pid=$! i=0 rc start=$SECONDS e
    local -a frames=('|' '/' '-' $'\x5c')
    printf '\e[?25l'
    while kill -0 "$pid" 2>/dev/null; do
        e=$(( SECONDS - start ))
        printf '\r    %s%s%s %s  %s%dm%02ds%s' "$C_B" "${frames[i++ % 4]}" "$C_0" \
               "$label" "$C_D" $(( e / 60 )) $(( e % 60 )) "$C_0"
        sleep 0.2
    done
    wait "$pid"; rc=$?
    e=$(( SECONDS - start ))
    printf '\r\e[2K\e[?25h'
    if [[ $rc -eq 0 ]]; then
        ok "$label  ${C_D}($(( e / 60 ))m$(( e % 60 ))s)${C_0}"
    else
        err "$label failed"
        say "    ${C_D}--- last 30 lines of $LOG ---${C_0}"
        tail -30 "$LOG" | sed 's/^/      /'
    fi
    return $rc
}

fail() {
    err "$*"
    say "    The full log is $LOG. $TARGET is left mounted to look around."
    say "    Alt+F2 has a shell."
    exit 1
}

part() { local d="$1" n="$2"; [[ $d =~ [0-9]$ ]] && echo "${d}p$n" || echo "$d$n"; }

# The partition a sgdisk -n just made: whichever exists now that did not
# before. Partition numbers are not a safe guess on a disk that already has
# some, and the kernel can take a moment to show the new node.
new_partition() {
    local disk="$1" before="$2" p waited=0
    partprobe "$disk" 2>/dev/null; udevadm settle 2>/dev/null
    while :; do
        p=$(comm -13 <(sort <<<"$before") <(lsblk -lnpo NAME "$disk" | sort) | tail -1)
        [[ -n $p && -b $p ]] && { echo "$p"; return; }
        sleep 1; waited=$((waited + 1))
        [[ $waited -ge 10 ]] && return 1
    done
}

wait_for() {
    local waited=0
    until [[ -b $1 ]]; do
        sleep 1; waited=$((waited + 1))
        [[ $waited -ge 10 ]] && return 1
    done
}

# ── preflight ─────────────────────────────────────────────────────────────────
# Everything that can fail while the disk is still intact fails here.
preflight() {
    step "Checking the medium"
    local missing=() t
    for t in sgdisk wipefs partprobe mkfs.fat mkfs.ext4 pacstrap arch-chroot genfstab \
             cryptsetup blkid; do
        command -v "$t" >/dev/null || missing+=("$t")
    done
    [[ ${ANS[fstype]} == btrfs ]] && { command -v mkfs.btrfs >/dev/null || missing+=(mkfs.btrfs); }
    [[ ${#missing[@]} -eq 0 ]] || die "missing on this medium: ${missing[*]}"
    [[ -f $REPO/core.db && -f $REPO/extra.db ]] || die "the package repository is missing from $REPO"
    [[ -f $LUCENT_SRC/install.sh ]] || die "the desktop setup is missing from $LUCENT_SRC"
    [[ -d /sys/firmware/efi ]] || die "this machine booted the medium in BIOS mode; starch installs for UEFI only"
    ok "tools, packages and the desktop setup are all here"

    mkdir -p "$WORK"
    : >"$LOG"
    chmod 600 "$LOG"

    # pacstrap reads the official databases and checks every package against
    # the keys in the live keyring, exactly as it would from a mirror.
    {
        printf '[options]\nArchitecture = auto\nSigLevel = Required DatabaseOptional\n'
        printf 'LocalFileSigLevel = Optional\nParallelDownloads = 5\n'
        local db
        for db in core extra multilib; do
            [[ -f $REPO/$db.db ]] && printf '\n[%s]\nServer = file://%s\n' "$db" "$REPO"
        done
        if [[ -f $LOCALREPO/starch-local.db ]]; then
            printf '\n[starch-local]\nSigLevel = Optional TrustAll\nServer = file://%s\n' "$LOCALREPO"
        fi
    } >"$WORK/pacman.conf"
}

# ── disk ──────────────────────────────────────────────────────────────────────
# Sets ESP, BOOT (the partition mounted at /boot, which is the ESP unless it is
# too small), ROOT_PART and ROOT_DEV (the mapper device when encrypted).
partition_erase() {
    local disk="${ANS[disk]}"
    step "Partitioning $disk"
    wipefs -af "$disk" >>"$LOG" 2>&1
    sgdisk --zap-all "$disk" >>"$LOG" 2>&1
    sgdisk --clear \
        --new=1:0:+1GiB --typecode=1:ef00 --change-name=1:EFI \
        --new=2:0:0     --typecode=2:8300 --change-name=2:starch \
        "$disk" >>"$LOG" 2>&1 || fail "partitioning failed"
    partprobe "$disk" 2>/dev/null; udevadm settle 2>/dev/null
    ESP=$(part "$disk" 1); ROOT_PART=$(part "$disk" 2); BOOT=$ESP; XBOOTLDR=""
    wait_for "$ESP" && wait_for "$ROOT_PART" || fail "$ESP and $ROOT_PART did not appear"
    mkfs.fat -F32 -n EFI "$ESP" >>"$LOG" 2>&1 || fail "mkfs.fat failed"
    ok "$ESP  EFI system partition, 1 GiB"
    ok "$ROOT_PART  root"
}

# Into the largest free block, with every existing partition left alone.
#
# The existing ESP is shared, so the firmware and systemd-boot see the other
# system as they did. But Windows makes its ESP 100 MiB, and a kernel with
# its initramfs and fallback does not fit beside Windows' own files. When
# there is not room, /boot goes on a separate XBOOTLDR partition, which
# systemd-boot reads natively, and the ESP is mounted at /efi.
partition_alongside() {
    local disk="${ANS[disk]}" before esp avail
    step "Adding partitions to the free space on $disk"

    esp=$(lsblk -lnpo NAME,PARTTYPE "$disk" | awk -v g="$ESP_GUID" 'tolower($2)==g {print $1; exit}')
    before=$(lsblk -lnpo NAME "$disk")
    if [[ -z $esp ]]; then
        sgdisk -n 0:0:+1GiB -t 0:ef00 -c 0:EFI "$disk" >>"$LOG" 2>&1 || fail "could not create an ESP"
        esp=$(new_partition "$disk" "$before") || fail "the new ESP did not appear"
        mkfs.fat -F32 -n EFI "$esp" >>"$LOG" 2>&1 || fail "mkfs.fat failed"
        ok "$esp  new EFI system partition, 1 GiB"
        before=$(lsblk -lnpo NAME "$disk")
    else
        ok "$esp  existing EFI system partition, shared"
    fi
    ESP=$esp

    mkdir -p "$WORK/esp"
    mount -o ro "$ESP" "$WORK/esp" || fail "could not read the existing ESP"
    avail=$(df -B1 --output=avail "$WORK/esp" | tail -1)
    umount "$WORK/esp"

    if [[ $avail -ge $((400 * 1024 ** 2)) ]]; then
        BOOT=$ESP; XBOOTLDR=""
        ok "$(numfmt --to=iec "$avail") free on it, enough for the kernel"
    else
        sgdisk -n 0:0:+1GiB -t 0:ea00 -c 0:XBOOTLDR "$disk" >>"$LOG" 2>&1 \
            || fail "could not create the /boot partition"
        XBOOTLDR=$(new_partition "$disk" "$before") || fail "the new /boot partition did not appear"
        mkfs.fat -F32 -n BOOT "$XBOOTLDR" >>"$LOG" 2>&1 || fail "mkfs.fat failed"
        BOOT=$XBOOTLDR
        ok "$XBOOTLDR  /boot, 1 GiB  (only $(numfmt --to=iec "$avail") free on the ESP)"
        before=$(lsblk -lnpo NAME "$disk")
    fi

    sgdisk -n 0:0:0 -t 0:8300 -c 0:starch "$disk" >>"$LOG" 2>&1 || fail "could not create the root partition"
    ROOT_PART=$(new_partition "$disk" "$before") || fail "the new root partition did not appear"
    ok "$ROOT_PART  root, $(numfmt --to=iec "$(blockdev --getsize64 "$ROOT_PART")")"
}

encrypt_root() {
    ROOT_DEV=$ROOT_PART
    [[ ${ANS[encrypt]} == yes ]] || return 0
    step "Encrypting $ROOT_PART"
    # Not through spin(), which gives its command /dev/null for stdin: the
    # passphrase would be read as empty. luksFormat takes a few seconds.
    printf '%s' "${ANS[passphrase]}" |
        cryptsetup luksFormat --type luks2 --batch-mode --key-file=- "$ROOT_PART" >>"$LOG" 2>&1 \
        || fail "cryptsetup luksFormat failed"
    printf '%s' "${ANS[passphrase]}" |
        cryptsetup open --key-file=- "$ROOT_PART" "$MAPPER" >>"$LOG" 2>&1 || fail "could not open $ROOT_PART"
    ROOT_DEV=/dev/mapper/$MAPPER
    ok "unlocked as $ROOT_DEV"
}

format_and_mount() {
    step "Formatting and mounting"
    mountpoint -q "$TARGET" && umount -R "$TARGET"
    mkdir -p "$TARGET"

    # btrfs gets the layout archinstall and most guides use, so snapshot tools
    # find what they expect: @ at /, @home at /home.
    if [[ ${ANS[fstype]} == btrfs ]]; then
        mkfs.btrfs -f -L starch "$ROOT_DEV" >>"$LOG" 2>&1 || fail "mkfs.btrfs failed"
        mount "$ROOT_DEV" "$TARGET" || fail "mount failed"
        btrfs subvolume create "$TARGET/@" >>"$LOG" 2>&1 && \
            btrfs subvolume create "$TARGET/@home" >>"$LOG" 2>&1 || fail "could not create subvolumes"
        umount "$TARGET"
        local o=compress=zstd,noatime
        mount -o "$o,subvol=@" "$ROOT_DEV" "$TARGET" || fail "mount of @ failed"
        mkdir -p "$TARGET/home"
        mount -o "$o,subvol=@home" "$ROOT_DEV" "$TARGET/home" || fail "mount of @home failed"
    else
        mkfs.ext4 -F -L starch "$ROOT_DEV" >>"$LOG" 2>&1 || fail "mkfs.ext4 failed"
        mount "$ROOT_DEV" "$TARGET" || fail "mount failed"
    fi

    # umask 0077: systemd-boot refuses to keep its random seed on a
    # world-readable filesystem, and genfstab copies these options as given.
    local vfat=fmask=0077,dmask=0077
    mkdir -p "$TARGET/boot"
    mount -o "$vfat" "$BOOT" "$TARGET/boot" || fail "could not mount /boot"
    if [[ -n $XBOOTLDR ]]; then
        mkdir -p "$TARGET/efi"
        mount -o "$vfat" "$ESP" "$TARGET/efi" || fail "could not mount the ESP"
    fi
    ok "${ANS[fstype]} on $ROOT_DEV"
    findmnt -nR "$TARGET" -o TARGET,SOURCE | sed 's/^/      /'
}

# ── base system ───────────────────────────────────────────────────────────────
# What the install guide pacstraps, and nothing more: everything on top comes
# from install.sh, exactly as it would on a machine installed by hand.
install_base() {
    step "Installing Arch"
    local -a pkgs=(base linux linux-firmware sudo networkmanager dosfstools)
    case $(awk -F': ' '/^vendor_id/ {print $2; exit}' /proc/cpuinfo) in
        GenuineIntel) pkgs+=(intel-ucode) ;;
        AuthenticAMD) pkgs+=(amd-ucode) ;;
    esac
    [[ ${ANS[fstype]} == btrfs ]] && pkgs+=(btrfs-progs)
    # The boot splash is starch's, so it is installed here rather than by
    # install.sh, which runs on machines starch does not own.
    pkgs+=(plymouth)
    [[ -n $CONSOLE_FONT ]] && pkgs+=(terminus-font)
    # The bluetooth half of the Broadcom chipsets in Intel MacBooks. It is
    # AUR-only, so a hand-installed Mac would build it with an AUR helper; the
    # medium carries it prebuilt in starch-local. Wireless is install.sh's job,
    # including the wl driver and the headers it builds against.
    if [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == "Apple Inc." ]] \
       && [[ -f $LOCALREPO/starch-local.db ]]; then
        pkgs+=(broadcom-bt-firmware)
    fi

    # -K a fresh keyring in the target, populated from archlinux-keyring as it
    # is installed. -M leaves the medium's mirrorlist behind; the real one is
    # written once the install no longer needs the local repository.
    spin "pacstrap: ${pkgs[*]}" pacstrap -K -M -C "$WORK/pacman.conf" "$TARGET" "${pkgs[@]}" \
        || fail "pacstrap failed"
}

configure_system() {
    step "Configuring the system"
    local u="${ANS[username]}"

    genfstab -U "$TARGET" >>"$TARGET/etc/fstab"
    ok "fstab"

    ln -sf "/usr/share/zoneinfo/${ANS[timezone]}" "$TARGET/etc/localtime"
    arch-chroot "$TARGET" hwclock --systohc >>"$LOG" 2>&1
    sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' "$TARGET/etc/locale.gen"
    arch-chroot "$TARGET" locale-gen >>"$LOG" 2>&1
    echo "LANG=en_US.UTF-8" >"$TARGET/etc/locale.conf"
    echo "KEYMAP=${ANS[keymap]}" >"$TARGET/etc/vconsole.conf"
    [[ -n $CONSOLE_FONT ]] && echo "FONT=$CONSOLE_FONT" >>"$TARGET/etc/vconsole.conf"
    echo "${ANS[hostname]}" >"$TARGET/etc/hostname"
    ok "${ANS[timezone]}, en_US.UTF-8, keyboard ${ANS[keymap]}, hostname ${ANS[hostname]}"

    arch-chroot "$TARGET" useradd -m -G wheel -s /bin/bash "$u" >>"$LOG" 2>&1 \
        || fail "could not create $u"
    printf '%s:%s\n' "$u" "${ANS[password]}" | arch-chroot "$TARGET" chpasswd \
        || fail "could not set the password"
    echo '%wheel ALL=(ALL:ALL) ALL' >"$TARGET/etc/sudoers.d/10-wheel"
    chmod 440 "$TARGET/etc/sudoers.d/10-wheel"
    ok "$u, with sudo through the wheel group"

    # Root keeps the locked password pacstrap gave it, which makes emergency
    # mode useless: it asks for root's password and there is none. sulogin
    # --force opens the shell anyway. Anyone at the keyboard can already get
    # one through the boot menu's editor with init=/bin/bash.
    local unit
    for unit in emergency rescue; do
        mkdir -p "$TARGET/etc/systemd/system/$unit.service.d"
        printf '[Service]\nEnvironment=SYSTEMD_SULOGIN_FORCE=1\n' \
            >"$TARGET/etc/systemd/system/$unit.service.d/sulogin-force.conf"
    done
    ok "emergency mode opens a shell with root locked"
    # NetworkManager is pacstrapped above and enabled by install.sh, as on a
    # machine installed by hand. Nothing else is enabled here: every unit this
    # enabled would be one a hand install does not have.
}

# ── boot ──────────────────────────────────────────────────────────────────────
# systemd-boot, with entries naming /vmlinuz-linux and the preset's images.
# Those are the files mkinitcpio's pacman hooks rewrite on every kernel
# upgrade, so the entries never go stale.
install_boot() {
    step "Installing the bootloader"
    local conf="$TARGET/etc/mkinitcpio.conf" opts root_uuid luks_uuid

    if [[ ${ANS[encrypt]} == yes ]]; then
        luks_uuid=$(blkid -s UUID -o value "$ROOT_PART")
        # The systemd-based initramfs is mkinitcpio's default and wants
        # sd-encrypt; a config still on the busybox hooks wants encrypt and a
        # different kernel argument. Either way the hook goes after block,
        # where the disk exists, and after keyboard, so the passphrase can
        # be typed.
        if grep -qE '^HOOKS=.*\bsystemd\b' "$conf"; then
            sed -i -E '/^HOOKS=/ s/\bblock\b/block sd-encrypt/' "$conf"
            opts="rd.luks.name=$luks_uuid=$MAPPER root=/dev/mapper/$MAPPER"
        else
            sed -i -E '/^HOOKS=/ s/\bblock\b/block encrypt/' "$conf"
            opts="cryptdevice=UUID=$luks_uuid:$MAPPER root=/dev/mapper/$MAPPER"
        fi
    else
        root_uuid=$(blkid -s UUID -o value "$ROOT_DEV")
        opts="root=UUID=$root_uuid"
    fi
    opts+=" rw"
    [[ ${ANS[fstype]} == btrfs ]] && opts+=" rootflags=subvol=@"

    # The splash: starch's theme from this medium, and the plymouth hook
    # straight after whichever of systemd or udev starts the initramfs. It has
    # to come before sd-encrypt too, or the passphrase is asked for on a text
    # console behind the splash. Escape still shows the text at any point.
    mkdir -p "$TARGET/usr/share/plymouth/themes/starch"
    cp /usr/share/plymouth/themes/starch/* "$TARGET/usr/share/plymouth/themes/starch/"
    printf '[Daemon]\nTheme=starch\nShowDelay=0\n' >"$TARGET/etc/plymouth/plymouthd.conf"
    sed -i -E '/^HOOKS=/ s/\b(systemd|udev)\b/\1 plymouth/' "$conf"
    grep -qE '^HOOKS=.*\bplymouth\b' "$conf" || warn "could not add the plymouth hook; no splash"
    opts+=" quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0"

    spin "Building the initramfs" arch-chroot "$TARGET" mkinitcpio -P || fail "mkinitcpio failed"

    local -a paths=(--esp-path=/boot)
    [[ -n $XBOOTLDR ]] && paths=(--esp-path=/efi --boot-path=/boot)
    spin "bootctl install" arch-chroot "$TARGET" bootctl install "${paths[@]}" \
        || fail "bootctl install failed"

    local entries="$TARGET/boot/loader/entries" loader
    loader="$TARGET$( [[ -n $XBOOTLDR ]] && echo /efi || echo /boot)/loader/loader.conf"
    mkdir -p "$entries"
    printf 'title   starch\nlinux   /vmlinuz-linux\ninitrd  /initramfs-linux.img\noptions %s\n' \
        "$opts" >"$entries/starch.conf"
    printf 'title   starch (fallback initramfs)\nlinux   /vmlinuz-linux\ninitrd  /initramfs-linux-fallback.img\noptions %s\n' \
        "$opts" >"$entries/starch-fallback.conf"
    printf 'default starch.conf\ntimeout 3\neditor  yes\n' >"$loader"
    ok "systemd-boot, entries starch and starch-fallback"
    [[ -n $XBOOTLDR ]] && ok "ESP at /efi, kernels on the XBOOTLDR partition at /boot"
}

# ── the desktop ───────────────────────────────────────────────────────────────
# install.sh in the chroot, reading packages from the medium. Its pacman sees
# the stock /etc/pacman.conf, as it would anywhere, and only the mirrorlist
# behind it points at the local repository while it runs — so the tuning
# install.sh writes into pacman.conf is the tuning the installed system keeps.
install_desktop() {
    step "Installing the Hyprland desktop"
    local u="${ANS[username]}" home="/home/${ANS[username]}"

    cp -r "$LUCENT_SRC" "$TARGET$home/lucent" || fail "could not copy the desktop setup"
    arch-chroot "$TARGET" chown -R "$u:$u" "$home/lucent"

    mkdir -p "$TARGET/run/starch-repo"
    mount --bind "$REPO" "$TARGET/run/starch-repo" || fail "could not mount the repository"
    cp "$TARGET/etc/pacman.d/mirrorlist" "$WORK/mirrorlist.stock"
    echo 'Server = file:///run/starch-repo' >"$TARGET/etc/pacman.d/mirrorlist"

    say "    ${C_D}The long step. Alt+F2 and  tail -f $LOG  to watch it.${C_0}"
    # Through bash rather than executed: mkarchiso copies the payload with
    # --no-preserve=mode, so install.sh arrives without its execute bit.
    spin "install.sh --for-user $u" \
        arch-chroot "$TARGET" bash "$home/lucent/install.sh" --for-user "$u"
    local rc=$?

    umount "$TARGET/run/starch-repo" 2>/dev/null
    rmdir "$TARGET/run/starch-repo" 2>/dev/null
    [[ $rc -eq 0 ]] || fail "the desktop install failed. Arch itself is installed and boots;
    after rebooting, log in and run:  ~/lucent/install.sh"
}

# The mirrorlist pacman-mirrorlist ships, with the worldwide geo mirror turned
# on: it redirects to a nearby mirror, which is what a fresh install wants
# until someone ranks them. rate-mirrors, from install.sh, does that properly.
write_mirrorlist() {
    local ml="$TARGET/etc/pacman.d/mirrorlist"
    cp "$WORK/mirrorlist.stock" "$ml"
    if grep -q '^#Server = https://geo.mirror.pkgbuild.com' "$ml"; then
        sed -i 's|^#\(Server = https://geo.mirror.pkgbuild.com\)|\1|' "$ml"
    else
        sed -i '1i Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' "$ml"
    fi
    ok "mirrorlist: geo.mirror.pkgbuild.com  (rank mirrors with rate-mirrors)"
}

finish() {
    step "Finishing"
    write_mirrorlist
    cp "$LOG" "$TARGET/var/log/starch-install.log" && chmod 600 "$TARGET/var/log/starch-install.log"
    ok "this install's log is at /var/log/starch-install.log"
    sync
    umount -R "$TARGET" 2>/dev/null
    [[ ${ANS[encrypt]} == yes ]] && cryptsetup close "$MAPPER" 2>/dev/null

    say
    gum style --border normal --border-foreground 2 --padding "1 2" --margin "0 2" \
        "starch is installed." "" "Remove the install medium, then log in as ${ANS[username]}."
    say
    case $(choose "Reboot" "Power off" "Stay here") in
        Reboot)      reboot ;;
        "Power off") poweroff ;;
    esac
}

# ── main ──────────────────────────────────────────────────────────────────────
pick_console_font
run_questions
clear
banner
preflight
# Nothing before this line has touched a disk.
case ${ANS[mode]} in
    erase)     partition_erase ;;
    alongside) partition_alongside ;;
esac
encrypt_root
format_and_mount
install_base
configure_system
install_boot
install_desktop
finish
